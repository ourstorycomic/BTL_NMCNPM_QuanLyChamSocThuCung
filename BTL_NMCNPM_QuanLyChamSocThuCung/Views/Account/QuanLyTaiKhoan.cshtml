@model IEnumerable<BTL_NMCNPM_QuanLyChamSocThuCung.Models.Account>
@{
    ViewData["Title"] = "Quản lý tài khoản";
}
<div class="container mt-4">
    <h2>QUẢN LÝ TÀI KHOẢN</h2>
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Tên đăng nhập</th>
                <th>Họ tên</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Username</td>
                    <td>@item.FullName</td>
                    <td>@item.Role</td>
                    <td>
                        @if (item.Status)
                        {
                            <span class="text-success">Hoạt động</span>
                        }
                        else
                        {

                            <span class="text-danger">Bị khóa</span>
                        }
                    </td>
                    <td>
                        <form asp-action="KhoaTaiKhoan" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm @(item.Status ? "btn-danger" : "btn-success")">
                                @(item.Status ? "Khóa" : "Mở khóa")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>