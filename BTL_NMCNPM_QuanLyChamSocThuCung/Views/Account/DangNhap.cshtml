@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập - PawHaven";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - PawHaven Chăm sóc thú cưng</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --paw-green: #10b981;
            --paw-green-dark: #059669;
            --paw-green-light: #ecfdf5;
            --paw-text-dark: #0f172a;
            --paw-text-muted: #64748b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            background-color: #f8fafc;
            color: var(--paw-text-dark);
            min-height: 100vh;
        }

        .login-wrapper {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        /* BANNER TRÁI (XANH LÁ PAWHAVEN) */
        .login-banner {
            flex: 1.1;
            background: linear-gradient(145deg, #10b981 0%, #059669 100%);
            padding: 48px 56px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            color: #ffffff;
        }

        /* Họa tiết chân mèo mờ nền */
        .paw-bg-pattern {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            opacity: 0.08;
            pointer-events: none;
            background-image: radial-gradient(#ffffff 2px, transparent 2px);
            background-size: 32px 32px;
        }

        .login-logo-box {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(255, 255, 255, 0.18);
            backdrop-filter: blur(8px);
            padding: 8px 18px;
            border-radius: 9999px;
            color: #ffffff;
            font-weight: 700;
            font-size: 1.1rem;
            width: fit-content;
        }

        .banner-slogan-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.15);
            padding: 6px 14px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 600;
            margin-bottom: 16px;
            letter-spacing: 0.02em;
        }

        .banner-heading {
            font-size: 2.35rem;
            font-weight: 800;
            line-height: 1.25;
            margin-bottom: 24px;
            max-width: 480px;
        }

        .illustration-card {
            background: #fffdf0;
            border-radius: 28px;
            padding: 24px 24px 0;
            position: relative;
            max-width: 460px;
            margin: 0 auto;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
            text-align: center;
        }

        .pet-hero-img {
            width: 100%;
            max-height: 320px;
            object-fit: cover;
            border-radius: 20px 20px 0 0;
            display: block;
        }

        /* Floating Badges */
        .badge-care-count {
            position: absolute;
            top: -18px;
            left: -16px;
            background: #ffffff;
            color: #0f172a;
            padding: 8px 16px;
            border-radius: 14px;
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 0.88rem;
        }

        .badge-rating {
            position: absolute;
            bottom: -16px;
            right: -16px;
            background: #ffffff;
            color: #0f172a;
            padding: 10px 18px;
            border-radius: 16px;
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
            text-align: left;
        }

        /* FORM BÊN PHẢI */
        .login-form-side {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 32px;
            background-color: #ffffff;
        }

        .login-card-inner {
            width: 100%;
            max-width: 440px;
        }

        .role-segment {
            display: flex;
            background-color: #f1f5f9;
            padding: 4px;
            border-radius: 12px;
            margin-bottom: 24px;
        }

        .role-tab-btn {
            flex: 1;
            border: none;
            background: transparent;
            padding: 8px 12px;
            font-size: 0.86rem;
            font-weight: 600;
            color: var(--paw-text-muted);
            border-radius: 9px;
            transition: all 0.2s ease;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .role-tab-btn.active {
            background-color: #ffffff;
            color: var(--paw-text-dark);
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
            font-weight: 700;
        }

        .paw-input-group {
            position: relative;
            margin-bottom: 18px;
        }

        .paw-input-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            color: #334155;
            margin-bottom: 6px;
        }

        .paw-input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .paw-input-icon {
            position: absolute;
            left: 14px;
            color: #94a3b8;
            font-size: 1rem;
        }

        .paw-input {
            width: 100%;
            padding: 11px 40px 11px 42px;
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            font-size: 0.92rem;
            color: var(--paw-text-dark);
            transition: all 0.2s;
            background-color: #ffffff;
        }

        .paw-input:focus {
            outline: none;
            border-color: var(--paw-green);
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
        }

        .paw-toggle-pass {
            position: absolute;
            right: 14px;
            color: #94a3b8;
            cursor: pointer;
            font-size: 1.05rem;
        }

        .btn-paw-submit {
            width: 100%;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #ffffff;
            border: none;
            padding: 13px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 0.98rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 8px 18px rgba(16, 185, 129, 0.28);
            transition: all 0.2s;
            cursor: pointer;
        }

        .btn-paw-submit:hover {
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(16, 185, 129, 0.35);
        }

        .btn-google {
            width: 100%;
            background: #ffffff;
            color: #334155;
            border: 1.5px solid #e2e8f0;
            padding: 11px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.2s;
            cursor: pointer;
        }

        .btn-google:hover {
            background-color: #f8fafc;
            border-color: #cbd5e1;
        }

        /* RESPONSIVE DESIGN */
        @@media (max-width: 991px) {
            .login-wrapper {
                flex-direction: column;
            }
            .login-banner {
                padding: 32px 24px;
                text-align: center;
            }
            .banner-heading {
                font-size: 1.75rem;
                margin: 0 auto 20px;
            }
            .login-logo-box {
                margin: 0 auto 20px;
            }
            .illustration-card {
                max-width: 320px;
            }
            .badge-care-count {
                left: -6px;
                top: -12px;
                font-size: 0.78rem;
                padding: 6px 12px;
            }
            .badge-rating {
                right: -6px;
                bottom: -12px;
                font-size: 0.78rem;
                padding: 6px 12px;
            }
            .login-form-side {
                padding: 32px 20px;
            }
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <!-- CỘT TRÁI: BANNER PAWHAVEN BRAND -->
        <div class="login-banner">
            <div class="paw-bg-pattern"></div>

            <div>
                <div class="login-logo-box mb-4">
                    <i class="bi bi-paw-fill"></i> PawHaven
                </div>

                <div class="banner-slogan-badge">
                    <i class="bi bi-shield-check"></i> Hệ thống quản lý chăm sóc thú cưng
                </div>

                <h1 class="banner-heading">
                    Mỗi bé cưng đều xứng đáng được yêu thương trọn vẹn.
                </h1>
            </div>

            <!-- Thẻ minh họa thú cưng với 2 Badge -->
            <div class="illustration-card my-4">
                <div class="badge-care-count">
                    <span class="rounded-circle bg-success bg-opacity-10 text-success p-1 d-inline-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                        <i class="bi bi-shield-check"></i>
                    </span>
                    <div>
                        <div class="lh-1">12.500+</div>
                        <small class="text-muted fw-normal" style="font-size: 0.7rem;">Bé cưng được chăm sóc</small>
                    </div>
                </div>

                <img src="https://images.unsplash.com/photo-1543466835-00a7907e9de1?w=600&auto=format&fit=crop&q=80" 
                     alt="Chó và mèo cưng PawHaven" class="pet-hero-img" />

                <div class="badge-rating">
                    <div class="text-warning small mb-1">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <strong class="text-dark ms-1">4.9</strong>
                    </div>
                    <small class="text-muted fw-normal" style="font-size: 0.7rem;">từ 3.200 khách hàng</small>
                </div>
            </div>

            <div class="small text-white-50">
                &copy; 2026 PawHaven Vietnam. All rights reserved.
            </div>
        </div>

        <!-- CỘT PHẢI: FORM ĐĂNG NHẬP -->
        <div class="login-form-side">
            <div class="login-card-inner">
                <div class="mb-4">
                    <h3 class="fw-bold text-dark mb-1">Chào mừng trở lại</h3>
                    <p class="text-muted small mb-0">
                        Đăng nhập để tiếp tục chăm sóc các bé cưng của bạn.
                    </p>
                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-3 small py-2 mb-3" role="alert">
                        <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (ViewBag.Loi != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 small py-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Loi
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Role Selector Tabs -->
                <div class="role-segment">
                    <button type="button" class="role-tab-btn active" id="tabCustomer" onclick="selectRole('Customer')">
                        <i class="bi bi-person"></i> Khách hàng
                    </button>
                    <button type="button" class="role-tab-btn" id="tabStaff" onclick="selectRole('Staff')">
                        <i class="bi bi-person-badge"></i> Nhân viên
                    </button>
                    <button type="button" class="role-tab-btn" id="tabAdmin" onclick="selectRole('Admin')">
                        <i class="bi bi-gear"></i> Quản trị
                    </button>
                </div>

                <form asp-action="DangNhap" method="post" id="loginForm">
                    @Html.AntiForgeryToken()

                    <div class="paw-input-group">
                        <label for="usernameInput">Tên đăng nhập hoặc Email</label>
                        <div class="paw-input-wrapper">
                            <i class="bi bi-envelope paw-input-icon"></i>
                            <input type="text" name="username" id="usernameInput" class="paw-input" 
                                   placeholder="VD: minhanh@gmail.com" required autocomplete="username" />
                        </div>
                    </div>

                    <div class="paw-input-group">
                        <label for="passwordInput">Mật khẩu</label>
                        <div class="paw-input-wrapper">
                            <i class="bi bi-lock paw-input-icon"></i>
                            <input type="password" name="password" id="passwordInput" class="paw-input" 
                                   placeholder="Nhập mật khẩu..." required autocomplete="current-password" />
                            <i class="bi bi-eye paw-toggle-pass" id="togglePasswordIcon" onclick="togglePasswordVisibility()"></i>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4 small">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberMeCheck" name="rememberMe" checked />
                            <label class="form-check-label text-muted" for="rememberMeCheck">Ghi nhớ đăng nhập</label>
                        </div>
                        <a asp-controller="Account" asp-action="QuenMatKhau" class="text-decoration-none text-muted fw-semibold">
                            Quên mật khẩu?
                        </a>
                    </div>

                    <button type="submit" class="btn-paw-submit mb-3">
                        Đăng nhập <i class="bi bi-arrow-right"></i>
                    </button>

                    <div class="text-center position-relative my-3">
                        <hr class="text-muted" style="opacity: 0.15;" />
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-2 small text-muted">hoặc</span>
                    </div>

                    <button type="button" class="btn-google mb-4" onclick="alert('Tính năng đăng nhập Google đang được tích hợp qua Google OAuth!')">
                        <svg width="18" height="18" viewBox="0 0 24 24">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                        </svg>
                        Tiếp tục với Google
                    </button>

                    <div class="text-center small text-muted">
                        Chưa có tài khoản? 
                        <a asp-controller="Account" asp-action="DangKy" class="text-success fw-bold text-decoration-none ms-1">
                            Đăng ký ngay
                        </a>
                    </div>

                    <div class="mt-4 pt-3 border-top text-center text-muted" style="font-size: 0.78rem;">
                        <i class="bi bi-shield-check text-success me-1"></i>
                        Đặt lịch, theo dõi hồ sơ và lịch sử chăm sóc của bé.
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function selectRole(role) {
            document.getElementById('tabCustomer').classList.remove('active');
            document.getElementById('tabStaff').classList.remove('active');
            document.getElementById('tabAdmin').classList.remove('active');

            const userInput = document.getElementById('usernameInput');
            const passInput = document.getElementById('passwordInput');

            if (role === 'Customer') {
                document.getElementById('tabCustomer').classList.add('active');
                userInput.value = 'minhanh';
                passInput.value = '123456';
            } else if (role === 'Staff') {
                document.getElementById('tabStaff').classList.add('active');
                userInput.value = 'letan';
                passInput.value = '123456';
            } else if (role === 'Admin') {
                document.getElementById('tabAdmin').classList.add('active');
                userInput.value = 'admin';
                passInput.value = '123456';
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            selectRole('Customer');
        });

        function togglePasswordVisibility() {
            const passInput = document.getElementById('passwordInput');
            const icon = document.getElementById('togglePasswordIcon');
            if (passInput.type === 'password') {
                passInput.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                passInput.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
</body>
</html>
