@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập - PawHaven";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - PawHaven Chăm sóc thú cưng</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <div class="login-wrapper">
        <!-- CỘT TRÁI: BANNER PAWHAVEN BRAND -->
        <div class="login-banner">
            <div class="paw-bg-pattern"></div>

            <div>
                <div class="login-logo-box mb-4">
                    <i class="bi bi-paw-fill"></i> PawHaven
                </div>

                <div class="banner-slogan-badge">
                    <i class="bi bi-shield-check"></i> Hệ thống quản lý chăm sóc thú cưng
                </div>

                <h1 class="banner-heading">
                    Mỗi bé cưng đều xứng đáng được yêu thương trọn vẹn.
                </h1>
            </div>

            <!-- Thẻ minh họa thú cưng với 2 Badge -->
            <div class="illustration-card my-4">
                <div class="badge-care-count">
                    <span class="rounded-circle bg-success bg-opacity-10 text-success p-1 d-inline-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                        <i class="bi bi-shield-check"></i>
                    </span>
                    <div>
                        <div class="lh-1">12.500+</div>
                        <small class="text-muted fw-normal" style="font-size: 0.7rem;">Bé cưng được chăm sóc</small>
                    </div>
                </div>

                <img src="https://images.unsplash.com/photo-1543466835-00a7907e9de1?w=600&auto=format&fit=crop&q=80" 
                     alt="Chó và mèo cưng PawHaven" class="pet-hero-img" />

                <div class="badge-rating">
                    <div class="text-warning small mb-1">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <strong class="text-dark ms-1">4.9</strong>
                    </div>
                    <small class="text-muted fw-normal" style="font-size: 0.7rem;">từ 3.200 khách hàng</small>
                </div>
            </div>

            <div class="small text-white-50">
                &copy; 2026 PawHaven Vietnam. All rights reserved.
            </div>
        </div>

        <!-- CỘT PHẢI: FORM ĐĂNG NHẬP -->
        <div class="login-form-side">
            <div class="login-card-inner">
                <div class="mb-4">
                    <h3 class="fw-bold text-dark mb-1">Chào mừng trở lại</h3>
                    <p class="text-muted small mb-0">
                        Đăng nhập để tiếp tục chăm sóc các bé cưng của bạn.
                    </p>
                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-3 small py-2 mb-3" role="alert">
                        <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (ViewBag.Loi != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 small py-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Loi
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-action="DangNhap" method="post" id="loginForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <div class="paw-input-group">
                        <label for="usernameInput">Tên đăng nhập hoặc Email</label>
                        <div class="paw-input-wrapper">
                            <i class="bi bi-envelope paw-input-icon"></i>
                            <input type="text" name="username" id="usernameInput" class="paw-input" 
                                   placeholder="Nhập tên đăng nhập hoặc email..." required autocomplete="username" />
                        </div>
                    </div>

                    <div class="paw-input-group">
                        <label for="passwordInput">Mật khẩu</label>
                        <div class="paw-input-wrapper">
                            <i class="bi bi-lock paw-input-icon"></i>
                            <input type="password" name="password" id="passwordInput" class="paw-input" 
                                   placeholder="Nhập mật khẩu..." required autocomplete="current-password" />
                            <i class="bi bi-eye paw-toggle-pass" id="togglePasswordIcon" onclick="togglePasswordVisibility()"></i>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4 small">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberMeCheck" name="rememberMe" checked />
                            <label class="form-check-label text-muted" for="rememberMeCheck">Ghi nhớ đăng nhập</label>
                        </div>
                        <a asp-controller="Account" asp-action="QuenMatKhau" class="text-decoration-none text-muted fw-semibold">
                            Quên mật khẩu?
                        </a>
                    </div>

                    <button type="submit" class="btn-paw-submit mb-3">
                        Đăng nhập <i class="bi bi-arrow-right"></i>
                    </button>

                    <div class="text-center position-relative my-3">
                        <hr class="text-muted" style="opacity: 0.15;" />
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-2 small text-muted">hoặc</span>
                    </div>

                    <button type="button" class="btn-google mb-4" onclick="alert('Tính năng đăng nhập Google đang được tích hợp qua Google OAuth!')">
                        <svg width="18" height="18" viewBox="0 0 24 24">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                        </svg>
                        Tiếp tục với Google
                    </button>

                    <div class="text-center small text-muted">
                        Chưa có tài khoản? 
                        <a asp-controller="Account" asp-action="DangKy" class="text-success fw-bold text-decoration-none ms-1">
                            Đăng ký ngay
                        </a>
                    </div>

                    <div class="mt-4 pt-3 border-top text-center">
                        <div class="text-muted small mb-2">Tài khoản thử nghiệm (bấm để điền nhanh):</div>
                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            <button type="button" class="btn btn-sm btn-light border rounded-pill px-2 py-1 small" onclick="fillAccount('admin', '123456')">
                                <i class="bi bi-shield-lock-fill text-danger me-1"></i>Quản trị (admin)
                            </button>
                            <button type="button" class="btn btn-sm btn-light border rounded-pill px-2 py-1 small" onclick="fillAccount('letan', '123456')">
                                <i class="bi bi-person-badge-fill text-primary me-1"></i>Nhân viên (letan)
                            </button>
                            <button type="button" class="btn btn-sm btn-light border rounded-pill px-2 py-1 small" onclick="fillAccount('minhanh', '123456')">
                                <i class="bi bi-person-fill text-success me-1"></i>Khách hàng (minhanh)
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function fillAccount(username, password) {
            const userInput = document.getElementById('usernameInput');
            const passInput = document.getElementById('passwordInput');
            userInput.value = username;
            passInput.value = password;
            userInput.focus();
        }

        function togglePasswordVisibility() {
            const passInput = document.getElementById('passwordInput');
            const icon = document.getElementById('togglePasswordIcon');
            if (passInput.type === 'password') {
                passInput.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                passInput.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
</body>
</html>
