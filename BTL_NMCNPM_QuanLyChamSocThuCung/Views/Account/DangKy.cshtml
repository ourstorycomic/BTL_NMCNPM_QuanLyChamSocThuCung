@{
    ViewData["Title"] = "Đăng ký thành viên PawHaven";
    Layout = null; // Standalone auth split-screen layout
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PawHaven Hệ thống Quản lý Chăm sóc Thú cưng</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-wrapper">
        <!-- CỘT TRÁI: BANNER PAWHAVEN VÀ MINH HỌA -->
        <div class="auth-banner">
            <div>
                <a asp-controller="Home" asp-action="Index" class="brand-badge text-decoration-none">
                    <span class="rounded-circle bg-success text-white p-1 d-inline-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                        <i class="bi bi-paw-fill small"></i>
                    </span>
                    <span>PawHaven</span>
                </a>

                <div class="tag-pill">
                    <i class="bi bi-shield-check"></i>
                    <span>Hệ thống quản lý chăm sóc thú cưng</span>
                </div>

                <h1 class="banner-heading">
                    Mỗi bé cưng đều<br />
                    xứng đáng được yêu<br />
                    thương trọn vẹn.
                </h1>
            </div>

            <!-- Thẻ ảnh minh họa thú cưng kèm số liệu thống kê -->
            <div class="illustration-card">
                <div class="floating-stat-card floating-stat-top">
                    <span class="rounded-circle bg-success bg-opacity-10 text-success p-2 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="bi bi-shield-check"></i>
                    </span>
                    <div class="text-start">
                        <div class="fw-bold" style="font-size: 0.95rem; line-height: 1;">12.500+</div>
                        <small class="text-muted" style="font-size: 0.7rem;">Bé cưng được chăm sóc</small>
                    </div>
                </div>

                <img src="https://images.unsplash.com/photo-1548767797-d8c844163c4c?w=500&auto=format&fit=crop&q=80" 
                     alt="PawHaven Pets" />

                <div class="floating-stat-card floating-stat-bottom">
                    <div class="text-start">
                        <div class="text-warning small" style="font-size: 0.8rem; line-height: 1;">
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <strong class="text-dark ms-1">4.9</strong>
                        </div>
                        <small class="text-muted" style="font-size: 0.7rem;">từ 3.200 khách hàng</small>
                    </div>
                </div>
            </div>

            <div class="d-none d-lg-block text-white-50 small mt-4">
                &copy; 2026 PawHaven. Chăm sóc thú cưng bằng cả trái tim.
            </div>
        </div>

        <!-- CỘT PHẢI: FORM ĐĂNG KÝ -->
        <div class="auth-form-wrapper">
            <div class="form-container">
                <div class="mb-4">
                    <h2 class="fw-bold text-dark mb-1">Tạo tài khoản mới</h2>
                    <p class="text-muted small">Đăng ký để đặt lịch, theo dõi hồ sơ và lịch sử chăm sóc của bé.</p>
                </div>

                @if (ViewBag.Loi != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 py-2 px-3 small mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Loi
                        <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-action="DangKy" method="post" id="registerForm">
                    @Html.AntiForgeryToken()

                    <!-- Họ và tên -->
                    <div class="mb-3">
                        <label class="form-label text-dark fw-semibold small mb-1">Họ và tên <span class="text-danger">*</span></label>
                        <div class="input-group-paw">
                            <i class="bi bi-person input-icon"></i>
                            <input type="text" name="FullName" class="form-control" placeholder="VD: Nguyễn Minh Anh" required />
                        </div>
                    </div>

                    <!-- Tên đăng nhập -->
                    <div class="mb-3">
                        <label class="form-label text-dark fw-semibold small mb-1">Tên đăng nhập <span class="text-danger">*</span></label>
                        <div class="input-group-paw">
                            <i class="bi bi-at input-icon"></i>
                            <input type="text" name="Username" class="form-control" placeholder="VD: minhanh2026" required />
                        </div>
                    </div>

                    <!-- Số điện thoại & Email -->
                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label text-dark fw-semibold small mb-1">Số điện thoại <span class="text-danger">*</span></label>
                            <div class="input-group-paw">
                                <i class="bi bi-telephone input-icon"></i>
                                <input type="tel" name="PhoneNumber" class="form-control" placeholder="VD: 0901234567" required />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-dark fw-semibold small mb-1">Email</label>
                            <div class="input-group-paw">
                                <i class="bi bi-envelope input-icon"></i>
                                <input type="email" name="Email" class="form-control" placeholder="email@gmail.com" />
                            </div>
                        </div>
                    </div>

                    <!-- Mật khẩu & Nhập lại mật khẩu -->
                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label text-dark fw-semibold small mb-1">Mật khẩu <span class="text-danger">*</span></label>
                            <div class="input-group-paw">
                                <i class="bi bi-lock input-icon"></i>
                                <input type="password" name="Password" id="inputPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
                                <button type="button" class="password-toggle-btn" onclick="togglePassVisibility('inputPassword', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-dark fw-semibold small mb-1">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                            <div class="input-group-paw">
                                <i class="bi bi-shield-lock input-icon"></i>
                                <input type="password" name="ConfirmPassword" id="inputConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu" required />
                                <button type="button" class="password-toggle-btn" onclick="togglePassVisibility('inputConfirmPassword', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Địa chỉ -->
                    <div class="mb-3">
                        <label class="form-label text-dark fw-semibold small mb-1">Địa chỉ (không bắt buộc)</label>
                        <div class="input-group-paw">
                            <i class="bi bi-geo-alt input-icon"></i>
                            <input type="text" name="Address" class="form-control" placeholder="VD: 42 Xuân Thủy, Thảo Điền, TP. Thủ Đức" />
                        </div>
                    </div>

                    <!-- Đồng ý điều khoản -->
                    <div class="form-check mb-4">
                        <input class="form-check-input mt-1" type="checkbox" id="termsCheck" required checked />
                        <label class="form-check-label text-muted small" for="termsCheck">
                            Tôi đồng ý với <a href="javascript:void(0)" class="text-success text-decoration-none fw-semibold">Điều khoản dịch vụ</a> và <a href="javascript:void(0)" class="text-success text-decoration-none fw-semibold">Chính sách bảo mật</a> của PawHaven.
                        </label>
                    </div>

                    <!-- Nút Đăng ký -->
                    <button type="submit" class="btn btn-register-submit mb-4">
                        <span>Đăng ký tài khoản</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>

                    <!-- Chuyển sang Đăng nhập -->
                    <div class="text-center text-muted small">
                        Đã có tài khoản?
                        <a asp-action="DangNhap" class="text-success fw-bold text-decoration-none ms-1">Đăng nhập ngay</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePassVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }
    </script>
</body>
</html>
