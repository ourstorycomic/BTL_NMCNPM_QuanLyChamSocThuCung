@{
    ViewData["Title"] = "Đăng ký";
}

<div class="container mt-5" style="max-width: 500px;">
    <h2 class="text-center">ĐĂNG KÝ</h2>

    @if (ViewBag.Loi != null)
    {
        <div class="alert alert-danger">@ViewBag.Loi</div>
    }

    <form asp-action="DangKy" method="post">
        @Html.AntiForgeryToken()

        <h5 class="text-primary mt-3">1. Thông tin tài khoản</h5>

        <div class="form-group mb-3">
            <label>Tên đăng nhập</label>
            <input name="Username" class="form-control" required />
        </div>
        <div class="form-group mb-3">
            <label>Mật khẩu</label>
            <input name="Password" type="password" class="form-control" required />
        </div>
        <div class="form-group mb-3">
            <label>Nhập lại mật khẩu</label>
            <input name="ConfirmPassword" type="password" class="form-control" required />
        </div>

        <h5 class="text-primary mt-4">2. Thông tin cá nhân</h5>

        <div class="form-group mb-3">
            <label>Họ và tên</label>
            <!-- Ô nhập này BẮT BUỘC phải có name="FullName" -->
            <input name="FullName" class="form-control" required />
        </div>
        <div class="form-group mb-3">
            <label>Số điện thoại</label>
            <input name="PhoneNumber" class="form-control" />
        </div>
        <div class="form-group mb-3">
            <label>Email</label>
            <input name="Email" type="email" class="form-control" />
        </div>
        <div class="form-group mb-3">
            <label>Địa chỉ</label>
            <input name="Address" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-3">ĐĂNG KÝ</button>
    </form>
</div>