@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="container mt-5 mb-5" style="max-width: 600px;">
    <div class="card shadow">
        <div class="card-header bg-primary text-white text-center">
            <h3 class="mb-0">ĐĂNG KÝ TÀI KHOẢN</h3>
        </div>
        <div class="card-body">
            @if (ViewBag.Loi != null)
            {
                <div class="alert alert-danger">@ViewBag.Loi</div>
            }

            <form asp-action="DangKy" method="post" id="registerForm">

                <!-- PHẦN 1: THÔNG TIN TÀI KHOẢN -->
                <h5 class="text-primary border-bottom pb-2 mb-3">1. Thông tin đăng nhập</h5>

                <div class="form-group mb-3">
                    <label class="fw-bold">Tên đăng nhập <span class="text-danger">*</span></label>
                    <input name="Username" id="username" class="form-control" required placeholder="Nhập tên đăng nhập..." />
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label class="fw-bold">Mật khẩu <span class="text-danger">*</span></label>
                        <input name="Password" id="password" type="password" class="form-control" required placeholder="Nhập mật khẩu..." />
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label class="fw-bold">Nhập lại mật khẩu <span class="text-danger">*</span></label>
                        <input name="ConfirmPassword" id="confirmPassword" type="password" class="form-control" required placeholder="Nhập lại mật khẩu..." />
                    </div>
                </div>

                <!-- PHẦN 2: THÔNG TIN KHÁCH HÀNG -->
                <h5 class="text-primary border-bottom pb-2 mb-3 mt-4">2. Thông tin cá nhân</h5>

                <div class="form-group mb-3">
                    <label class="fw-bold">Họ và tên <span class="text-danger">*</span></label>
                    <input name="CustomerName" class="form-control" required placeholder="Nhập họ và tên..." />
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label class="fw-bold">Số điện thoại</label>
                        <input name="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại..." />
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label class="fw-bold">Email</label>
                        <input name="Email" type="email" class="form-control" placeholder="Nhập địa chỉ email..." />
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label class="fw-bold">Địa chỉ</label>
                    <input name="Address" class="form-control" placeholder="Nhập địa chỉ..." />
                </div>

                <!-- NÚT ĐĂNG KÝ -->
                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">ĐĂNG KÝ NGAY</button>

                <div class="text-center mt-3">
                    <span>Đã có tài khoản? </span>
                    <a href="/Account/DangNhap" class="text-decoration-none">Đăng nhập tại đây</a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JAVASCRIPT KIỂM TRA DỮ LIỆU -->
<script>
    document.getElementById("registerForm").addEventListener("submit", function (event) {
        var pass = document.getElementById("password").value;
        var confirmPass = document.getElementById("confirmPassword").value;

        // Kiểm tra mật khẩu nhập lại có khớp không
        if (pass !== confirmPass) {
            event.preventDefault(); // Chặn form gửi lên Server
            alert("Mật khẩu nhập lại không khớp! Vui lòng kiểm tra lại.");
        }
    });
</script>