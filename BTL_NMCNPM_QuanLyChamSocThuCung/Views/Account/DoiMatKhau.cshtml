@{
    ViewData["Title"] = "Đổi mật khẩu";
}
<div class="container mt-5" style="max-width: 400px;">
    <h2 class="text-center">ĐỔI MẬT KHẨU</h2>
    @if (ViewBag.Loi != null)
    {
        <div class="alert alert-danger">@ViewBag.Loi</div>
    }
    <form asp-action="DoiMatKhau" method="post">
        @Html.AntiForgeryToken()
        <div class="form-group mb-3"><label>Mật khẩu cũ</label><input name="oldPassword" type="password" class="form-control" required /></div>
        <div class="form-group mb-3"><label>Mật khẩu mới</label><input name="newPassword" type="password" class="form-control" required /></div>
        <div class="form-group mb-3"><label>Nhập lại mật khẩu mới</label><input name="confirmPassword" type="password" class="form-control" required /></div>
        <button type="submit" class="btn btn-warning w-100">CẬP NHẬT</button>
    </form>
</div>