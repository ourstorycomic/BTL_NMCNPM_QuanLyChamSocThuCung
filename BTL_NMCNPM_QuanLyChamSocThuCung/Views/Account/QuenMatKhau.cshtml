@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container mt-5" style="max-width: 400px;">
    <h2 class="text-center">QUÊN MẬT KHẨU</h2>

    @if (ViewBag.Loi != null)
    {
        <div class="alert alert-danger">@ViewBag.Loi</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form asp-action="QuenMatKhau" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group mb-3">
            <label>Tên đăng nhập</label>
            <input name="username" class="form-control" required />
        </div>
        <div class="form-group mb-3">
            <label>Số điện thoại đã đăng ký</label>
            <input name="phoneNumber" type="tel" class="form-control" required />
        </div>
        <div class="form-group mb-3">
            <label>Mật khẩu mới</label>
            <input name="newPassword" type="password" class="form-control" required />
        </div>

        <div class="form-group mb-3">
            <label>Nhập lại mật khẩu mới</label>
            <input name="confirmPassword" type="password" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-warning w-100">ĐẶT LẠI MẬT KHẨU</button>
    </form>
</div>