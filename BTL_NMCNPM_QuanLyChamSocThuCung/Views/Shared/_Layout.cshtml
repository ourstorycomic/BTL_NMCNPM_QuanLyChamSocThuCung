<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PawHaven Hệ thống Quản lý Chăm sóc Thú cưng</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    @{
        // Tự động nhận diện vai trò từ phiên đăng nhập thực tế của hệ thống
        string? sessionRole = null;
        string? sessionName = null;
        try
        {
            sessionRole = Context.Session?.GetString("UserRole");
            sessionName = Context.Session?.GetString("FullName");
        }
        catch { }

        var currentRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value
                          ?? sessionRole
                          ?? Context.Request.Cookies["UserRole"];

        bool isAuthenticated = User.Identity?.IsAuthenticated == true || !string.IsNullOrEmpty(sessionRole) || !string.IsNullOrEmpty(Context.Request.Cookies["UserRole"]);

        bool isStaffView = isAuthenticated && (currentRole == "Staff" || currentRole == "Admin" || User.IsInRole("Staff") || User.IsInRole("Admin"));

        var currentUserName = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Name)?.Value
                              ?? sessionName
                              ?? Context.Request.Cookies["FullName"]
                              ?? (isAuthenticated ? (isStaffView ? "Hoàng Thu Trang" : "Nguyễn Minh Anh") : "Khách");

        var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    @if (isStaffView)
    {
        <!-- GÓC NHÌN NHÂN VIÊN (STAFF) - CÓ THANH SIDEBAR KIỂU PAWHAVEN -->
        <aside class="staff-sidebar">
            <!-- Brand Logo -->
            <div class="d-flex align-items-center justify-content-between p-3 border-bottom">
                <a asp-controller="Pet" asp-action="Index" class="d-flex align-items-center text-decoration-none">
                    <span class="rounded-3 bg-success bg-gradient text-white p-2 d-inline-flex align-items-center justify-content-center me-2 shadow-sm" style="width: 38px; height: 38px;">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                            <ellipse cx="12" cy="16.5" rx="5" ry="4"/>
                            <circle cx="6" cy="10" r="2.2"/>
                            <circle cx="10" cy="6.8" r="2.2"/>
                            <circle cx="14" cy="6.8" r="2.2"/>
                            <circle cx="18" cy="10" r="2.2"/>
                        </svg>
                    </span>
                    <span class="fs-5 fw-bold text-dark tracking-tight">PawHaven</span>
                </a>
                <span class="badge bg-light text-secondary border fw-bold" style="font-size: 0.68rem; letter-spacing: 0.05em;">STAFF</span>
            </div>

            <!-- Menu list -->
            <div class="flex-grow-1 overflow-auto py-2">
                <div class="sidebar-section-title">VẬN HÀNH</div>
                <a href="javascript:void(0)" class="sidebar-link text-muted">
                    <i class="bi bi-grid"></i>Tổng quan
                </a>
                <a asp-controller="Reception" asp-action="Index" class="sidebar-link @(currentCtrl == "Reception" ? "active" : "text-muted") d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-clipboard2-check"></i>Tiếp nhận tại quầy</span>
                    <span class="badge rounded-pill bg-success" style="font-size: 0.7rem;">6</span>
                </a>
                <a asp-controller="Appointment" asp-action="Index" class="sidebar-link @(currentCtrl == "Appointment" ? "active" : "text-muted")">
                    <i class="bi bi-calendar3"></i>Lịch hẹn
                </a>
                <a href="javascript:void(0)" class="sidebar-link text-muted">
                    <i class="bi bi-scissors"></i>Đang thực hiện
                </a>
                <a href="javascript:void(0)" class="sidebar-link text-muted">
                    <i class="bi bi-houses"></i>Khách sạn
                </a>

                <div class="sidebar-section-title mt-2">QUẢN LÝ & BÁO CÁO</div>
                <a asp-controller="Customer" asp-action="Index" class="sidebar-link @(currentCtrl == "Customer" ? "active" : "text-muted")">
                    <i class="bi bi-people"></i>Khách hàng
                </a>
                <a asp-controller="Service" asp-action="Index" class="sidebar-link @(currentCtrl == "Service" ? "active" : "text-muted")">
                    <i class="bi bi-tags"></i>Bảng giá dịch vụ
                </a>
                <a asp-controller="Pet" asp-action="Index" class="sidebar-link @(currentCtrl == "Pet" ? "active" : "text-muted")">
                    <i class="bi bi-heart-pulse-fill"></i>Hồ sơ thú cưng
                </a>
                <a asp-controller="Billing" asp-action="Index" class="sidebar-link @(currentCtrl == "Billing" ? "active" : "text-muted")">
                    <i class="bi bi-receipt"></i>Thanh toán & Hóa đơn
                </a>
                <a asp-controller="Report" asp-action="Index" class="sidebar-link @(currentCtrl == "Report" ? "active" : "text-muted")">
                    <i class="bi bi-graph-up-arrow"></i>Báo cáo doanh thu
                </a>
                <a href="javascript:void(0)" class="sidebar-link text-muted">
                    <i class="bi bi-gear"></i>Cài đặt
                </a>
            </div>

            <!-- Footer User Profile in Sidebar -->
            <div class="p-3 border-top bg-light d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80" 
                         alt="Staff Avatar" class="rounded-circle me-2 object-fit-cover shadow-sm" style="width: 36px; height: 36px;">
                    <div>
                        <div class="fw-bold small text-dark lh-sm">@currentUserName</div>
                        <div class="text-muted" style="font-size: 0.72rem;">@(currentRole == "Admin" ? "Quản trị viên" : "Lễ tân · Ca sáng")</div>
                    </div>
                </div>
                <a asp-controller="Account" asp-action="DangXuat" class="btn btn-sm btn-light border text-danger rounded-circle p-1 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Đăng xuất">
                    <i class="bi bi-box-arrow-right"></i>
                </a>
            </div>
        </aside>

        <!-- Backdrop for mobile sidebar -->
        <div class="staff-sidebar-backdrop" id="staffBackdrop" onclick="toggleStaffSidebar()"></div>

        <!-- Main Content Area (Staff) -->
        <div class="staff-main-content">
            <!-- Top Navbar for Staff -->
            <header class="bg-white border-bottom py-2 px-3 px-md-4 d-flex justify-content-between align-items-center sticky-top">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-light border d-lg-none p-1 px-2 rounded-3 me-1" type="button" onclick="toggleStaffSidebar()" title="Mở danh mục">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <span class="badge rounded-pill bg-success-subtle text-success fw-bold px-3 py-2 border border-success-subtle">
                        <i class="bi bi-clock-fill me-1"></i>Ca sáng · 07:30 - 14:00
                    </span>
                    <span class="text-muted small d-none d-sm-inline">Chi nhánh Thảo Điền</span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-light rounded-circle p-2 text-muted" type="button">
                        <i class="bi bi-bell"></i>
                    </button>
                    <div class="d-flex align-items-center gap-2 bg-light rounded-pill p-1 pe-3 border">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80" 
                             alt="Staff Avatar" class="rounded-circle object-fit-cover shadow-sm" style="width: 32px; height: 32px;">
                        <div class="text-start">
                            <div class="fw-bold small text-dark lh-1">@currentUserName</div>
                            <span class="badge bg-success text-white p-0 px-1" style="font-size: 0.65rem;">Nhân viên</span>
                        </div>
                    </div>
                </div>
            </header>

            <main role="main" class="p-4 flex-grow-1">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                        <i class="bi bi-check-circle-fill text-success me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>

            <footer class="border-top py-3 px-4 bg-white text-muted small d-flex justify-content-between align-items-center">
                <span>&copy; 2026 PawHaven - Hệ thống Quản lý Chăm sóc Thú cưng</span>
                <span>Phiên bản BTL NMCNPM</span>
            </footer>
        </div>
    }
    else
    {
        <!-- GÓC NHÌN KHÁCH HÀNG (CUSTOMER) - HEADER CHUẨN THIẾT KẾ PAWHAVEN -->
        <header class="customer-header sticky-top">
            <div class="container py-2">
                <div class="d-flex align-items-center justify-content-between">
                    <!-- Brand -->
                    <a asp-controller="Pet" asp-action="Index" class="d-flex align-items-center text-decoration-none">
                        <span class="rounded-3 bg-success bg-gradient text-white p-2 d-inline-flex align-items-center justify-content-center me-2 shadow-sm" style="width: 38px; height: 38px;">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                                <ellipse cx="12" cy="16.5" rx="5" ry="4"/>
                                <circle cx="6" cy="10" r="2.2"/>
                                <circle cx="10" cy="6.8" r="2.2"/>
                                <circle cx="14" cy="6.8" r="2.2"/>
                                <circle cx="18" cy="10" r="2.2"/>
                            </svg>
                        </span>
                        <span class="fs-4 fw-bold text-dark tracking-tight">PawHaven</span>
                    </a>

                    <!-- Nav Links -->
                    <nav class="d-flex align-items-center gap-1">
                        <a asp-controller="Home" asp-action="Index" class="customer-nav-link @(currentCtrl == "Home" ? "active" : "")">Trang chủ</a>
                        <a asp-controller="Service" asp-action="Index" class="customer-nav-link @(currentCtrl == "Service" ? "active" : "")">Dịch vụ</a>
                        <a asp-controller="Appointment" asp-action="Create" class="customer-nav-link @(currentCtrl == "Appointment" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")">Đặt lịch</a>
                        <a asp-controller="Appointment" asp-action="Index" class="customer-nav-link @(currentCtrl == "Appointment" && ViewContext.RouteData.Values["action"]?.ToString() != "Create" ? "active" : "")">Lịch hẹn của tôi</a>
                        <a asp-controller="Pet" asp-action="Index" class="customer-nav-link @(currentCtrl == "Pet" ? "active" : "")">Thú cưng</a>
                    </nav>

                    <!-- Right User Information or Login/Register -->
                    <div class="d-flex align-items-center gap-2">
                        @if (isAuthenticated)
                        {
                            <button class="btn btn-light rounded-circle p-2 text-muted" type="button" title="Thông báo">
                                <i class="bi bi-bell"></i>
                            </button>

                            <div class="dropdown">
                                <button class="btn btn-light d-flex align-items-center gap-2 rounded-pill p-1 pe-3 border dropdown-toggle" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&auto=format&fit=crop&q=80" 
                                         alt="Customer Avatar" class="rounded-circle object-fit-cover shadow-sm" style="width: 32px; height: 32px;">
                                    <div class="text-start">
                                        <div class="fw-bold small text-dark lh-1">@currentUserName</div>
                                        <span class="badge bg-warning text-dark p-0 px-1" style="font-size: 0.65rem;">Khách thân thiết</span>
                                    </div>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2" aria-labelledby="userMenuDropdown">
                                    <li><a class="dropdown-item py-2" asp-controller="Pet" asp-action="Index"><i class="bi bi-heart-pulse-fill text-success me-2"></i>Hồ sơ thú cưng</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Appointment" asp-action="Index"><i class="bi bi-calendar3 text-primary me-2"></i>Lịch hẹn của tôi</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 text-danger fw-semibold" asp-controller="Account" asp-action="DangXuat"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="DangNhap" class="btn btn-paw-outline text-nowrap px-3 py-1">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                            </a>
                            <a asp-controller="Account" asp-action="DangKy" class="btn btn-paw-primary text-nowrap px-3 py-1">
                                <i class="bi bi-person-plus-fill me-1"></i>Đăng ký
                            </a>
                        }
                    </div>
                </div>
            </div>
        </header>

        <div class="paw-main-container px-3 px-md-4 py-4">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top py-4 bg-white text-muted small mt-5">
            <div class="container text-center">
                <div class="d-flex justify-content-center align-items-center gap-2 mb-2">
                    <span class="rounded-3 bg-success text-white p-1 d-inline-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                        <i class="bi bi-paw-fill small"></i>
                    </span>
                    <strong class="text-dark">PawHaven</strong> - Chăm sóc thú cưng bằng cả trái tim.
                </div>
                <div>&copy; 2026 PawHaven · BTL Nhập môn Công nghệ Phần mềm · Điều khoản & Chính sách</div>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleStaffSidebar() {
            const sidebar = document.querySelector('.staff-sidebar');
            const backdrop = document.getElementById('staffBackdrop');
            if (sidebar) sidebar.classList.toggle('show');
            if (backdrop) backdrop.classList.toggle('show');
        }
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
