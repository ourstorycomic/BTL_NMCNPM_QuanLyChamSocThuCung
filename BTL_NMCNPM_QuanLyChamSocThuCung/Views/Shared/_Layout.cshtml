<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BTL_NMCNPM_QuanLyChamSocThuCung</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f4f7f6;
            overflow-x: hidden;
        }
        
        /* PawHaven Green Color */
        :root {
            --paw-green: #10b981;
            --paw-hover: #059669;
        }

        .btn-paw {
            background-color: var(--paw-green);
            color: white;
            border: none;
        }

            .btn-paw:hover {
                background-color: var(--paw-hover);
                color: white;
            }

        .text-paw {
            color: var(--paw-green) !important;
        }

        /* Sidebar Layout */
        .wrapper {
            display: flex;
            width: 100%;
            align-items: stretch;
        }

        #sidebar {
            min-width: 250px;
            max-width: 250px;
            background: #ffffff;
            color: #333;
            transition: all 0.3s;
            border-right: 1px solid #e5e5e5;
            min-height: 100vh;
        }

            #sidebar .sidebar-header {
                padding: 20px;
                background: #f8f9fa;
                border-bottom: 1px solid #e5e5e5;
            }

            #sidebar ul.components {
                padding: 20px 0;
                border-bottom: 1px solid #e5e5e5;
            }

            #sidebar ul p {
                color: #333;
                padding: 10px 20px;
                font-weight: bold;
                font-size: 0.85rem;
                text-transform: uppercase;
                margin: 0;
            }

            #sidebar ul li a {
                padding: 12px 20px;
                font-size: 1rem;
                display: block;
                color: #555;
                text-decoration: none;
                border-left: 3px solid transparent;
                transition: 0.2s;
            }

                #sidebar ul li a:hover {
                    color: var(--paw-green);
                    background: #f0fdf4;
                    border-left-color: var(--paw-green);
                }

                #sidebar ul li a.active {
                    color: var(--paw-green);
                    background: #f0fdf4;
                    border-left-color: var(--paw-green);
                    font-weight: 600;
                }
        
        #content {
            width: 100%;
            padding: 20px;
            min-height: 100vh;
        }

        .hover-lift {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .hover-lift:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
            }
    </style>
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar">
            <div class="sidebar-header">
                <h5 class="fw-bold mb-0 text-paw"><i class="bi bi-paw-fill me-2"></i>PawHaven</h5>
            </div>

            <ul class="list-unstyled components">
                <p>Chung</p>
                <li>
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-2"></i>Trang chủ</a>
                </li>
                
                <p>QUẢN LÝ</p>
                <li>
                    <a asp-controller="Customer" asp-action="Index"><i class="bi bi-people me-2"></i>Khách hàng</a>
                </li>
                <li>
                    <a asp-controller="Service" asp-action="Index"><i class="bi bi-tags me-2"></i>Dịch vụ</a>
                </li>
                <li>
                    <a asp-controller="Pet" asp-action="Index"><i class="bi bi-heart-pulse me-2"></i>Hồ sơ Thú cưng</a>
                </li>
                <li>
                    <a asp-controller="Home" asp-action="Privacy"><i class="bi bi-shield-check me-2"></i>Chính sách</a>
                </li>
            </ul>
        </nav>

        <!-- Page Content -->
        <div id="content">
            <nav class="navbar navbar-expand-lg navbar-light bg-white rounded shadow-sm mb-4 px-3">
                <div class="container-fluid">
                    <span class="navbar-brand mb-0 h1 fs-5 text-muted">Hệ thống quản lý chăm sóc thú cưng</span>
                    
                    <div class="d-flex align-items-center">
                        @{
                            var activeRole = Context.Request.Cookies["PetCare_ActiveRole"] ?? "Customer";
                        }
                        <div class="dropdown">
                            <button class="btn btn-sm @(activeRole == "Staff" ? "btn-warning" : "btn-paw") dropdown-toggle shadow-sm rounded-pill px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi @(activeRole == "Staff" ? "bi-person-badge-fill" : "bi-person-heart") me-1"></i>
                                Vai trò: <strong>@(activeRole == "Staff" ? "Nhân viên" : "Khách hàng")</strong>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li><h6 class="dropdown-header">Chuyển góc nhìn:</h6></li>
                                <li><a class="dropdown-item" asp-controller="Pet" asp-action="SwitchRole" asp-route-role="Customer" asp-route-returnUrl="@Context.Request.Path">Khách hàng</a></li>
                                <li><a class="dropdown-item" asp-controller="Pet" asp-action="SwitchRole" asp-route-role="Staff" asp-route-returnUrl="@Context.Request.Path">Nhân viên / Bác sĩ</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>

            <main role="main">
                <!-- Hiển thị thông báo Success/Error toàn cục -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>