@model IEnumerable<BTL_NMCNPM_QuanLyChamSocThuCung.Models.Service>
@{
    ViewData["Title"] = "Quản lý Dịch Vụ";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary fw-bold mb-0"><i class="bi bi-tags-fill me-2"></i>Bảng Giá Dịch Vụ</h2>
            <p class="text-muted small mb-0">Quản lý danh mục các dịch vụ chăm sóc thú cưng</p>
        </div>
        <a asp-action="Create" class="btn btn-success shadow-sm"><i class="bi bi-plus-circle-fill me-1"></i> Thêm Dịch Vụ</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-success text-white shadow-sm border-0">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-scissors fs-1 me-3 opacity-50"></i>
                    <div>
                        <h6 class="mb-0 opacity-75">Dịch Vụ Đang Cung Cấp</h6>
                        <h3 class="mb-0 fw-bold">@Model.Count()</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-center">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchString" class="form-control border-start-0 bg-light" placeholder="Tìm kiếm tên dịch vụ hoặc phân loại..." value="@ViewData["CurrentFilter"]" />
                    </div>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary me-2"><i class="bi bi-funnel"></i> Lọc</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i> Làm mới</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Tên Dịch Vụ</th>
                            <th>Phân Loại</th>
                            <th>Thời Gian</th>
                            <th>Giá Cơ Bản</th>
                            <th class="text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">@item.ServiceName</td>
                                <td><span class="badge bg-info text-dark px-3 py-2 rounded-pill">@item.Category</span></td>
                                <td><i class="bi bi-clock text-muted me-1"></i> @item.DurationMinutes phút</td>
                                <td class="text-danger fw-bold fs-6">@item.BasePrice.ToString("N0") <small>VNĐ</small></td>
                                <td class="text-center pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.ServiceId" class="btn btn-sm btn-outline-primary" title="Sửa"><i class="bi bi-pencil-square"></i></a>
                                    <form asp-action="Delete" asp-route-id="@item.ServiceId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn ngừng cung cấp dịch vụ này?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>