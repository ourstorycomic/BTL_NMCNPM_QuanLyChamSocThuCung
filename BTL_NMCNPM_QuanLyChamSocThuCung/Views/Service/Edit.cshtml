@model BTL_NMCNPM_QuanLyChamSocThuCung.Models.Service
@{
    ViewData["Title"] = "Sửa Dịch Vụ";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header border-0 py-4" style="background-color: #f59e0b;">
                    <h4 class="mb-0 fw-bold text-white text-center"><i class="bi bi-pencil-square me-2"></i>Chỉnh Sửa Dịch Vụ</h4>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="ServiceId" />
                        
                        <!-- HIỂN THỊ LỖI (Bao gồm cả lỗi Validate từ Controller) -->
                        <div asp-validation-summary="All" class="text-danger mb-3 fw-bold"></div>

                        <div class="mb-4">
                            <label asp-for="ServiceName" class="form-label fw-bold text-muted small">TÊN DỊCH VỤ <span class="text-danger">*</span></label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-tag text-secondary"></i></span>
                                <input asp-for="ServiceName" class="form-control border-0 bg-light" />
                            </div>
                            <span asp-validation-for="ServiceName" class="text-danger small"></span>
                        </div>
                        
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="Category" class="form-label fw-bold text-muted small">PHÂN LOẠI <span class="text-danger">*</span></label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-0"><i class="bi bi-collection text-secondary"></i></span>
                                    <input asp-for="Category" class="form-control border-0 bg-light" />
                                </div>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DurationMinutes" class="form-label fw-bold text-muted small">THỜI GIAN (PHÚT) <span class="text-danger">*</span></label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-0"><i class="bi bi-clock-history text-secondary"></i></span>
                                    <input asp-for="DurationMinutes" type="number" class="form-control border-0 bg-light" />
                                </div>
                                <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="WeightTierMin" class="form-label fw-bold text-muted small">CÂN NẶNG TỐI THIỂU (KG)</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-0"><i class="bi bi-arrow-down-circle text-secondary"></i></span>
                                    <input asp-for="WeightTierMin" type="number" step="0.01" class="form-control border-0 bg-light" />
                                </div>
                                <span asp-validation-for="WeightTierMin" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="WeightTierMax" class="form-label fw-bold text-muted small">CÂN NẶNG TỐI ĐA (KG)</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-0"><i class="bi bi-arrow-up-circle text-secondary"></i></span>
                                    <input asp-for="WeightTierMax" type="number" step="0.01" class="form-control border-0 bg-light" />
                                </div>
                                <span asp-validation-for="WeightTierMax" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="BasePrice" class="form-label fw-bold text-muted small">GIÁ CƠ BẢN (VNĐ) <span class="text-danger">*</span></label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-cash-coin text-secondary"></i></span>
                                <input asp-for="BasePrice" type="number" class="form-control border-0 bg-light" />
                            </div>
                            <span asp-validation-for="BasePrice" class="text-danger small"></span>
                        </div>
                        
                        <div class="mb-5">
                            <label asp-for="Description" class="form-label fw-bold text-muted small">MÔ TẢ CHI TIẾT</label>
                            <textarea asp-for="Description" class="form-control border-0 bg-light p-3" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-light btn-lg px-4 rounded-pill text-muted"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
                            <button type="submit" class="btn btn-lg px-5 rounded-pill shadow text-white" style="background-color: #f59e0b;"><i class="bi bi-save me-1"></i> Lưu Thay Đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}