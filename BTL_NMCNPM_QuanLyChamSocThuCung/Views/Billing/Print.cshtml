@model BTL_NMCNPM_QuanLyChamSocThuCung.Models.Invoice
@{
    Layout = null; // Trang in riêng biệt không dùng master layout để khi in ra giấy trắng đẹp nhất
    var appt = Model.Appointment;
    var pet = appt.Pet;
    var customer = pet.Customer;
    var subtotal = Model.InvoiceDetails.Sum(x => x.Amount);
    if (subtotal == 0) subtotal = Model.TotalAmount - Model.Surcharge + Model.DiscountAmount;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hóa đơn #HD-@Model.InvoiceId.ToString().Substring(0, 6).ToUpper() - PawHaven</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f1f5f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #1e293b;
            padding: 30px 10px;
        }

        .receipt-container {
            max-width: 650px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            padding: 40px;
            position: relative;
        }

        .receipt-header {
            text-align: center;
            border-bottom: 2px dashed #e2e8f0;
            padding-bottom: 24px;
            margin-bottom: 24px;
        }

        .receipt-logo {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #059669;
            font-size: 1.75rem;
            font-weight: 800;
            text-decoration: none;
        }

        .receipt-table th {
            background-color: #f8fafc;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
        }

        .floating-actions {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 1000;
            display: flex;
            gap: 10px;
        }

        @@media print {
            body {
                background: #ffffff;
                padding: 0;
            }
            .receipt-container {
                box-shadow: none;
                border-radius: 0;
                padding: 20px;
                max-width: 100%;
            }
            .floating-actions {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="receipt-container">
        <!-- Header -->
        <div class="receipt-header">
            <div class="receipt-logo mb-1">
                <i class="bi bi-paw-fill"></i> PawHaven
            </div>
            <div class="fw-bold text-dark fs-5">HỆ THỐNG CHĂM SÓC THÚ CƯNG CAO CẤP</div>
            <div class="text-muted small">Chi nhánh Thảo Điền: 42 Xuân Thủy, P. Thảo Điền, TP. Thủ Đức, TP.HCM</div>
            <div class="text-muted small">Hotline: 1900 6868 · Website: www.pawhaven.vn</div>
            <div class="mt-3">
                <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-1.5 fs-6">
                    <i class="bi bi-check-circle-fill me-1"></i>HÓA ĐƠN THANH TOÁN DỊCH VỤ
                </span>
            </div>
        </div>

        <!-- Thông tin hóa đơn & Khách hàng -->
        <div class="row g-3 mb-4 small">
            <div class="col-6">
                <div class="text-muted">MÃ HÓA ĐƠN:</div>
                <div class="fw-bold text-dark fs-6">#HD-@Model.InvoiceId.ToString().Substring(0, 8).ToUpper()</div>
                <div class="text-muted mt-2">THỜI GIAN LẬP:</div>
                <div class="fw-semibold">@((Model.PaymentTime ?? Model.CreatedAt).ToString("dd/MM/yyyy HH:mm"))</div>
            </div>
            <div class="col-6 text-end">
                <div class="text-muted">KHÁCH HÀNG:</div>
                <div class="fw-bold text-dark fs-6">@customer.CustomerName</div>
                <div class="text-muted">SĐT: @customer.PhoneNumber</div>
                <div class="text-muted mt-2">BÉ CƯNG:</div>
                <div class="fw-semibold">@pet.PetName (@pet.Species - @pet.Breed)</div>
            </div>
        </div>

        <!-- Bảng chi tiết dịch vụ -->
        <div class="table-responsive mb-4">
            <table class="table receipt-table align-middle">
                <thead>
                    <tr>
                        <th>Tên dịch vụ</th>
                        <th class="text-center">SL</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.InvoiceDetails != null && Model.InvoiceDetails.Any())
                    {
                        foreach (var d in Model.InvoiceDetails)
                        {
                            <tr>
                                <td><strong>@d.Service.ServiceName</strong></td>
                                <td class="text-center">@d.Quantity</td>
                                <td class="text-end">@d.UnitPrice.ToString("N0") đ</td>
                                <td class="text-end fw-bold">@d.Amount.ToString("N0") đ</td>
                            </tr>
                        }
                    }
                    else if (appt.AppointmentServices != null && appt.AppointmentServices.Any())
                    {
                        foreach (var s in appt.AppointmentServices)
                        {
                            <tr>
                                <td><strong>@s.Service.ServiceName</strong></td>
                                <td class="text-center">@s.Quantity</td>
                                <td class="text-end">@s.Service.BasePrice.ToString("N0") đ</td>
                                <td class="text-end fw-bold">@((s.Quantity * s.Service.BasePrice).ToString("N0")) đ</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Tính tiền & Tổng cộng -->
        <div class="border-top pt-3 mb-4">
            <div class="d-flex justify-content-between mb-1 small">
                <span class="text-muted">Tổng tiền dịch vụ:</span>
                <span class="fw-semibold">@subtotal.ToString("N0") đ</span>
            </div>

            @if (Model.Surcharge > 0)
            {
                <div class="d-flex justify-content-between mb-1 small text-danger">
                    <span>Phụ phí phát sinh (@(string.IsNullOrEmpty(Model.SurchargeReason) ? "Ghi nhận quầy" : Model.SurchargeReason)):</span>
                    <span class="fw-semibold">+@Model.Surcharge.ToString("N0") đ</span>
                </div>
            }

            @if (Model.DiscountAmount > 0)
            {
                <div class="d-flex justify-content-between mb-1 small text-success">
                    <span>Khuyến mãi (@Model.DiscountCode):</span>
                    <span class="fw-semibold">-@Model.DiscountAmount.ToString("N0") đ</span>
                </div>
            }

            <div class="d-flex justify-content-between align-items-center border-top border-2 border-dark pt-3 mt-2">
                <span class="fw-bold fs-5 text-dark">TỔNG CỘNG:</span>
                <span class="fw-bold fs-3 text-success">@Model.TotalAmount.ToString("N0") VNĐ</span>
            </div>

            <div class="d-flex justify-content-between small text-muted mt-2">
                <span>Hình thức thanh toán:</span>
                <span class="fw-semibold text-dark">
                    @(Model.PaymentMethod == "QRCode" ? "Chuyển khoản QR Code (Đã xác nhận)" : "Tiền mặt tại quầy")
                </span>
            </div>
        </div>

        <!-- Footer biên lai -->
        <div class="text-center pt-3 border-top small text-muted">
            <div class="mb-1"><i class="bi bi-heart-fill text-danger"></i> Cảm ơn Quý khách đã tin tưởng gửi gắm bé cưng tại PawHaven!</div>
            <div>Hẹn gặp lại bé <strong>@pet.PetName</strong> trong những lần chăm sóc tiếp theo.</div>
            <div class="fst-italic text-secondary mt-2" style="font-size: 0.72rem;">(Biên lai điện tử hợp lệ theo quy định của PawHaven · Mã tra cứu: #@Model.InvoiceId.ToString().Substring(0, 12))</div>
        </div>
    </div>

    <!-- Nút in nổi -->
    <div class="floating-actions">
        <a href="/Billing" class="btn btn-light shadow border rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i>Về danh sách
        </a>
        <button type="button" onclick="window.print()" class="btn btn-success shadow rounded-pill px-4 fw-bold">
            <i class="bi bi-printer-fill me-1"></i>In Hóa đơn
        </button>
    </div>
</body>
</html>
