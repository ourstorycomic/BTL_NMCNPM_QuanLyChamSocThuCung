@model BTL_NMCNPM_QuanLyChamSocThuCung.ViewModels.BillingCheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán & Lập hóa đơn - " + Model.CustomerName;
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Hóa đơn & Thu ngân</a></li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">Lập hóa đơn & Thanh toán (UC12)</li>
            </ol>
        </nav>
        <h3 class="fw-bold text-dark mb-0 d-flex align-items-center">
            <span class="rounded-3 bg-success bg-opacity-10 text-success p-2 d-inline-flex align-items-center justify-content-center me-2" style="width: 38px; height: 38px;">
                <i class="bi bi-credit-card-2-front-fill"></i>
            </span>
            Thanh toán dịch vụ thú cưng
        </h3>
    </div>
    <a asp-action="Index" class="btn btn-paw-outline">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>
</div>

<form asp-action="ProcessPayment" method="post" id="checkoutForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="AppointmentId" value="@Model.AppointmentId" />

    <div class="row g-4">
        <!-- CỘT TRÁI: CHI TIẾT DỊCH VỤ & KHÁCH HÀNG -->
        <div class="col-lg-8">
            <!-- Thẻ thông tin khách hàng & bé cưng -->
            <div class="paw-card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                    <span class="fw-bold text-success">
                        <i class="bi bi-person-badge-fill me-1"></i> Hồ sơ khách hàng & Thú cưng
                    </span>
                    <span class="badge bg-light text-dark border">
                        Lịch hẹn: @Model.AppointmentDate.ToString("HH:mm dd/MM/yyyy")
                    </span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="d-flex align-items-start gap-3">
                            <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center text-secondary fw-bold" style="width: 44px; height: 44px; font-size: 1.2rem;">
                                @(string.IsNullOrEmpty(Model.CustomerName) ? "K" : Model.CustomerName.Substring(0, 1).ToUpper())
                            </div>
                            <div>
                                <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Chủ nuôi</small>
                                <div class="fw-bold fs-6">@Model.CustomerName</div>
                                <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@Model.PhoneNumber</div>
                                @if (!string.IsNullOrEmpty(Model.Address))
                                {
                                    <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@Model.Address</div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="d-flex align-items-start gap-3">
                            <div class="rounded-3 bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center fw-bold fs-4" style="width: 44px; height: 44px;">
                                @(Model.Species == "Mèo" ? "🐱" : "🐶")
                            </div>
                            <div>
                                <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Bé cưng tiếp nhận</small>
                                <div class="fw-bold fs-6">@Model.PetName <small class="text-muted fw-normal">(@Model.Species - @Model.Breed)</small></div>
                                <div class="text-dark small"><i class="bi bi-speedometer2 me-1"></i>Cân nặng thực tế: <strong>@Model.ActualWeight kg</strong></div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.AllergyNote))
                {
                    <div class="mt-3 p-3 rounded-3" style="background-color: #fefce8; border: 1px solid #fef08a; color: #854d0e; font-size: 0.88rem;">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
                        <strong>Lưu ý y tế/dị ứng của bé:</strong> @Model.AllergyNote
                    </div>
                }
            </div>

            <!-- Bảng dịch vụ đã thực hiện -->
            <div class="paw-card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-list-check text-success me-2"></i>Bảng kê chi tiết dịch vụ
                    </h5>
                    <span class="badge bg-success bg-opacity-10 text-success">@Model.Services.Count dịch vụ</span>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>TÊN DỊCH VỤ</th>
                                <th>PHÂN LOẠI</th>
                                <th class="text-center">SỐ LƯỢNG</th>
                                <th class="text-end">ĐƠN GIÁ</th>
                                <th class="text-end">THÀNH TIỀN</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var svc in Model.Services)
                            {
                                <tr>
                                    <td><strong class="text-dark">@svc.ServiceName</strong></td>
                                    <td><span class="badge bg-light text-secondary border">@svc.Category</span></td>
                                    <td class="text-center fw-semibold">@svc.Quantity</td>
                                    <td class="text-end">@svc.UnitPrice.ToString("N0") đ</td>
                                    <td class="text-end fw-bold text-dark">@svc.Amount.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="border-top">
                            <tr>
                                <td colspan="4" class="text-end fw-bold">Tổng tiền dịch vụ gốc:</td>
                                <td class="text-end fw-bold fs-6 text-dark" id="displaySubtotal">@Model.ServiceTotal.ToString("N0") đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Phụ phí phát sinh & Mã giảm giá (UC12: 4.7.1.4) -->
            <div class="paw-card p-4 mb-4">
                <h5 class="fw-bold mb-3 text-dark">
                    <i class="bi bi-sliders text-warning me-2"></i>Điều chỉnh Phụ phí & Khuyến mãi
                </h5>

                <div class="row g-3">
                    <!-- Phụ phí phát sinh -->
                    <div class="col-md-6">
                        <div class="p-3 rounded-4 border bg-light h-100">
                            <label class="form-label fw-bold text-dark small mb-1">
                                <i class="bi bi-plus-circle text-warning me-1"></i>Phụ phí phát sinh (nếu có)
                            </label>
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                <button type="button" class="btn btn-sm btn-light border rounded-pill py-0 px-2 small" onclick="setSurcharge(50000, 'Lông quá rối cần gỡ rối chuyên sâu')">+50k Lông rối</button>
                                <button type="button" class="btn btn-sm btn-light border rounded-pill py-0 px-2 small" onclick="setSurcharge(30000, 'Tắm trị ve rận đặc trị')">+30k Trị ve</button>
                                <button type="button" class="btn btn-sm btn-light border rounded-pill py-0 px-2 small" onclick="setSurcharge(40000, 'Khách đón muộn / lưu chuồng thêm')">+40k Đón muộn</button>
                            </div>
                            <div class="mb-2">
                                <div class="input-group">
                                    <input type="number" step="1000" min="0" name="Surcharge" id="inputSurcharge" 
                                           value="@Model.Surcharge.ToString("0")" class="form-control fw-bold text-danger" oninput="recalcTotal()" />
                                    <span class="input-group-text">VNĐ</span>
                                </div>
                            </div>
                            <div>
                                <input type="text" name="SurchargeReason" id="inputSurchargeReason" value="@Model.SurchargeReason" 
                                       class="form-control form-control-sm" placeholder="Lý do phụ phí (VD: Lông quá bết rối...)" />
                            </div>
                        </div>
                    </div>

                    <!-- Mã giảm giá / Khuyến mãi (FR-21) -->
                    <div class="col-md-6">
                        <div class="p-3 rounded-4 border bg-light h-100">
                            <label class="form-label fw-bold text-dark small mb-1">
                                <i class="bi bi-tag-fill text-success me-1"></i>Mã khuyến mãi / Giảm giá (FR-21)
                            </label>
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                <span class="badge bg-white text-muted border small cursor-pointer" onclick="fillPromo('PAWNEW')">PAWNEW (-10%)</span>
                                <span class="badge bg-white text-muted border small cursor-pointer" onclick="fillPromo('PAWHAVEN')">PAWHAVEN (-30k)</span>
                                <span class="badge bg-white text-muted border small cursor-pointer" onclick="fillPromo('VIP20')">VIP20 (-20k)</span>
                            </div>
                            <div class="input-group mb-2">
                                <input type="text" name="DiscountCode" id="inputPromoCode" value="@Model.DiscountCode" 
                                       class="form-control text-uppercase fw-bold" placeholder="Nhập mã voucher..." />
                                <button type="button" class="btn btn-paw-outline" onclick="applyPromo()">Áp dụng</button>
                            </div>
                            <input type="hidden" name="DiscountAmount" id="inputDiscountAmount" value="@Model.DiscountAmount.ToString("0")" />
                            <div id="promoMessage" class="small text-muted">
                                @if (Model.DiscountAmount > 0)
                                {
                                    <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Đã giảm: -@Model.DiscountAmount.ToString("N0")đ (@Model.DiscountCode)</span>
                                }
                                else
                                {
                                    <span>Gợi ý: Nhập <strong>PAWNEW</strong> hoặc <strong>PAWHAVEN</strong></span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: TỔNG KẾT THANH TOÁN & VIETQR DYNAMIC -->
        <div class="col-lg-4">
            <div class="paw-card p-4 position-sticky" style="top: 20px;">
                <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">
                    <i class="bi bi-calculator text-success me-2"></i>Tổng kết thanh toán
                </h5>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Tiền dịch vụ gốc:</span>
                    <strong class="text-dark">@Model.ServiceTotal.ToString("N0") đ</strong>
                </div>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Phụ phí phát sinh (+):</span>
                    <strong class="text-danger" id="summarySurcharge">+@Model.Surcharge.ToString("N0") đ</strong>
                </div>

                <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                    <span class="text-muted">Giảm giá (-):</span>
                    <strong class="text-success" id="summaryDiscount">-@Model.DiscountAmount.ToString("N0") đ</strong>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="fw-bold text-dark fs-6">TỔNG THỰC THU:</span>
                    <span class="fs-3 fw-bold text-success" id="summaryFinalTotal">@Model.FinalTotal.ToString("N0") <small class="fs-6">đ</small></span>
                </div>

                <!-- Chọn phương thức thanh toán -->
                <div class="mb-4">
                    <label class="form-label fw-bold text-dark small mb-2">Phương thức thanh toán <span class="text-danger">*</span></label>
                    <div class="d-grid gap-2">
                        <label class="btn btn-outline-success text-start d-flex align-items-center justify-content-between p-3 rounded-3" for="methodCash">
                            <div class="d-flex align-items-center gap-2">
                                <input class="form-check-input mt-0" type="radio" name="PaymentMethod" id="methodCash" value="Cash" checked onchange="togglePaymentMethod('Cash')" />
                                <div>
                                    <div class="fw-bold">Tiền mặt (Cash)</div>
                                    <small class="text-muted">Khách gửi tiền mặt tại quầy thu ngân</small>
                                </div>
                            </div>
                            <i class="bi bi-cash-stack fs-4"></i>
                        </label>

                        <label class="btn btn-outline-primary text-start d-flex align-items-center justify-content-between p-3 rounded-3" for="methodQR">
                            <div class="d-flex align-items-center gap-2">
                                <input class="form-check-input mt-0" type="radio" name="PaymentMethod" id="methodQR" value="QRCode" onchange="togglePaymentMethod('QRCode')" />
                                <div>
                                    <div class="fw-bold">Chuyển khoản QR Code</div>
                                    <small class="text-muted">Quét mã VietQR tự động điền số tiền</small>
                                </div>
                            </div>
                            <i class="bi bi-qr-code-scan fs-4"></i>
                        </label>
                    </div>
                </div>

                <!-- Khung hiển thị mã VietQR động -->
                <div id="qrBox" class="p-3 rounded-4 border text-center mb-4" style="display: none; background-color: #f8fafc;">
                    <small class="text-muted d-block mb-2 fw-semibold">Quét mã QR bằng App Ngân hàng bất kỳ</small>
                    <div class="bg-white p-2 d-inline-block rounded-3 shadow-sm border mb-2">
                        <img id="vietQrImg" src="" alt="Mã thanh toán QR" style="width: 190px; height: 190px; object-fit: contain;" />
                    </div>
                    <div class="small fw-bold text-dark">Ngân hàng Quân Đội (MB Bank)</div>
                    <div class="small text-muted">STK: <strong>0901234567</strong> · Chủ TK: <strong>PAWHAVEN THAO DIEN</strong></div>
                    <div class="small text-primary mt-1" id="qrNoteText">Nội dung: PAWHAVEN</div>
                </div>

                <!-- Nút xác nhận thanh toán -->
                <button type="submit" class="btn btn-paw-primary w-100 py-3 fs-6 shadow fw-bold">
                    <i class="bi bi-check2-circle me-1"></i>Xác nhận đã thanh toán & In hóa đơn
                </button>
            </div>
        </div>
    </div>
</form>

<script>
    const baseSubtotal = @Model.ServiceTotal;
    const apptIdShort = '@Model.AppointmentId.ToString().Substring(0, 6).ToUpper()';

    function setSurcharge(amount, reason) {
        document.getElementById('inputSurcharge').value = amount;
        document.getElementById('inputSurchargeReason').value = reason;
        recalcTotal();
    }

    function fillPromo(code) {
        document.getElementById('inputPromoCode').value = code;
        applyPromo();
    }

    async function applyPromo() {
        const code = document.getElementById('inputPromoCode').value.trim();
        const msgEl = document.getElementById('promoMessage');
        if (!code) {
            msgEl.innerHTML = '<span class="text-danger">Vui lòng nhập mã giảm giá.</span>';
            return;
        }

        msgEl.innerHTML = '<span class="text-muted"><i class="bi bi-hourglass-split me-1"></i>Đang kiểm tra mã...</span>';

        try {
            const resp = await fetch('@Url.Action("CheckPromo", "Billing")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code: code, subtotal: baseSubtotal })
            });
            const data = await resp.json();

            if (data.success) {
                document.getElementById('inputDiscountAmount').value = data.discountAmount;
                msgEl.innerHTML = `<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>${data.message}</span>`;
            } else {
                document.getElementById('inputDiscountAmount').value = 0;
                msgEl.innerHTML = `<span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i>${data.message}</span>`;
            }
            recalcTotal();
        } catch (e) {
            msgEl.innerHTML = '<span class="text-danger">Lỗi kết nối kiểm tra mã.</span>';
        }
    }

    function recalcTotal() {
        const surcharge = Math.max(0, parseFloat(document.getElementById('inputSurcharge').value) || 0);
        const discount = Math.max(0, parseFloat(document.getElementById('inputDiscountAmount').value) || 0);
        const finalTotal = Math.max(0, baseSubtotal + surcharge - discount);

        document.getElementById('summarySurcharge').textContent = '+' + surcharge.toLocaleString('vi-VN') + ' đ';
        document.getElementById('summaryDiscount').textContent = '-' + discount.toLocaleString('vi-VN') + ' đ';
        document.getElementById('summaryFinalTotal').innerHTML = finalTotal.toLocaleString('vi-VN') + ' <small class="fs-6">đ</small>';

        updateQrImage(finalTotal);
    }

    function togglePaymentMethod(method) {
        const qrBox = document.getElementById('qrBox');
        if (method === 'QRCode') {
            qrBox.style.display = 'block';
            recalcTotal();
        } else {
            qrBox.style.display = 'none';
        }
    }

    function updateQrImage(amount) {
        const qrBox = document.getElementById('qrBox');
        if (qrBox.style.display !== 'none') {
            const note = 'PAWHAVEN ' + apptIdShort;
            const qrUrl = `https://img.vietqr.io/image/MB-0901234567-compact2.png?amount=${amount}&addInfo=${encodeURIComponent(note)}&accountName=PAWHAVEN%20THAO%20DIEN`;
            document.getElementById('vietQrImg').src = qrUrl;
            document.getElementById('qrNoteText').textContent = 'Nội dung CK: ' + note;
        }
    }
</script>
