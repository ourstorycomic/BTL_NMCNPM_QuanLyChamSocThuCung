@model BTL_NMCNPM_QuanLyChamSocThuCung.ViewModels.AppointmentCreateViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Đặt lịch hẹn trực tuyến";
    var defaultDate = Model.AppointmentDate ?? DateTime.Today;
}

<div class="booking-container py-3">
    <!-- Breadcrumb & Page Heading -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Đặt lịch hẹn</li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-3">
            <div>
                <h3 class="fw-bold text-dark mb-1">Đặt lịch hẹn trực tuyến</h3>
                <p class="text-muted small mb-0">Chỉ vài bước để bé cưng được chăm sóc tận tình. Chúng tôi sẽ xác nhận lịch hẹn qua tin nhắn trong vòng 15 phút.</p>
            </div>
            
            <!-- Stepper 4 bước chuẩn Figma -->
            <div class="d-none d-md-flex align-items-center gap-3">
                <div class="stepper-item">
                    <span class="stepper-dot"><i class="bi bi-check"></i></span>
                    <span>Thú cưng</span>
                </div>
                <div class="text-muted small">›</div>
                <div class="stepper-item">
                    <span class="stepper-dot"><i class="bi bi-check"></i></span>
                    <span>Dịch vụ</span>
                </div>
                <div class="text-muted small">›</div>
                <div class="stepper-item">
                    <span class="stepper-dot"><i class="bi bi-check"></i></span>
                    <span>Ngày giờ</span>
                </div>
                <div class="text-muted small">›</div>
                <div class="stepper-item inactive">
                    <span class="stepper-dot inactive">4</span>
                    <span>Ghi chú</span>
                </div>
            </div>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4"></div>
    }

    <form method="post" id="bookingForm" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="StartTime" id="startTimeInput" value="10:00" />
        <input type="hidden" asp-for="AppointmentDate" id="appointmentDateInput" value="@defaultDate.ToString("yyyy-MM-dd")" />

        <div class="row g-4">
            <!-- CỘT TRÁI: 4 BƯỚC ĐẶT LỊCH -->
            <div class="col-12 col-lg-8">
                <!-- 01. CHỌN THÚ CƯNG -->
                <div class="booking-card p-4 mb-4">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="step-number-badge">01</span>
                        <div>
                            <h5 class="fw-bold text-dark mb-0">@(Model.IsAuthenticated && !Model.IsStaffOrAdmin ? "Thú cưng của bạn" : (Model.IsStaffOrAdmin ? "Khách hàng & Thú cưng" : "Thông tin đặt lịch"))</h5>
                            <small class="text-muted">@(Model.IsAuthenticated && !Model.IsStaffOrAdmin ? "Chọn bé cưng sẽ sử dụng dịch vụ hôm nay" : (Model.IsStaffOrAdmin ? "Chọn khách hàng và thú cưng cần đặt lịch" : "Nhập thông tin người đặt và bé cưng để giữ chỗ nhanh"))</small>
                        </div>
                    </div>

                    <div class="mt-3">
                        @if (Model.IsAuthenticated && !Model.IsStaffOrAdmin)
                        {
                            <!-- Giao diện khách hàng đã đăng nhập (Chuẩn Figma Mockup) -->
                            <input type="hidden" asp-for="CustomerId" value="@Model.CustomerId" id="customerSelect" />
                            
                            <div class="p-3 mb-3 rounded-3 border bg-light-subtle d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                        <i class="bi bi-person-fill fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@Model.LoggedInCustomerName</div>
                                        <div class="text-muted small">SĐT: @Model.LoggedInPhoneNumber · <span class="badge bg-warning text-dark border">Khách thân thiết</span></div>
                                    </div>
                                </div>
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill small">
                                    <i class="bi bi-shield-check me-1"></i> Hồ sơ của bạn
                                </span>
                            </div>

                            <label class="form-label text-dark fw-bold small mb-1">Thú cưng của bạn <span class="text-danger">*</span></label>
                            <div class="row g-2 align-items-center">
                                <div class="col-12">
                                    <select asp-for="PetId" id="petSelect" class="form-select rounded-3 py-2 fw-semibold" onchange="onPetChanged()">
                                        <!-- Danh sách bé cưng của khách -->
                                    </select>
                                </div>
                            </div>
                        }
                        else if (Model.IsStaffOrAdmin)
                        {
                            <!-- Giao diện dành cho Nhân viên lễ tân / Quản trị viên đặt lịch hộ khách -->
                            <div class="row g-2 align-items-center">
                                <div class="col-12 col-sm-6">
                                    <label class="form-label text-dark fw-bold small mb-1">Chọn khách hàng <span class="text-danger">*</span></label>
                                    <select asp-for="CustomerId" id="customerSelect" class="form-select rounded-3 py-2">
                                        <option value="">-- Chọn khách hàng --</option>
                                        @foreach (var c in Model.Customers)
                                        {
                                            <option value="@c.Id">@c.CustomerName (@c.PhoneNumber)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="form-label text-dark fw-bold small mb-1">Chọn thú cưng <span class="text-danger">*</span></label>
                                    <select asp-for="PetId" id="petSelect" class="form-select rounded-3 py-2 fw-semibold" onchange="onPetChanged()">
                                        <option value="">-- Chọn thú cưng --</option>
                                    </select>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Giao diện dành cho KHÁCH VÃNG LAI (Chưa đăng nhập) -->
                            <div class="alert alert-light border border-success-subtle rounded-3 p-3 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2" style="background-color: #f0fdf4;">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-info-circle-fill text-success fs-5"></i>
                                    <div class="small">
                                        <strong>Bạn đã có tài khoản PawHaven?</strong>
                                        <div class="text-muted">Đăng nhập để tự động điền hồ sơ bé cưng và tích lũy điểm thưởng thành viên.</div>
                                    </div>
                                </div>
                                <a asp-controller="Account" asp-action="DangNhap" asp-route-returnUrl="/Appointment/Create" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập ngay
                                </a>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-12 col-sm-6">
                                    <label class="form-label small fw-bold text-dark mb-1">Họ và tên của bạn <span class="text-danger">*</span></label>
                                    <input asp-for="GuestCustomerName" class="form-control rounded-3 py-2" placeholder="VD: Nguyễn Văn An" id="guestNameInput" oninput="updateGuestInfo()" />
                                    <span asp-validation-for="GuestCustomerName" class="text-danger small"></span>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="form-label small fw-bold text-dark mb-1">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                                    <input asp-for="GuestPhoneNumber" class="form-control rounded-3 py-2" placeholder="VD: 0987654321" id="guestPhoneInput" />
                                    <span asp-validation-for="GuestPhoneNumber" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-12 col-sm-4">
                                    <label class="form-label small fw-bold text-dark mb-1">Tên bé cưng <span class="text-danger">*</span></label>
                                    <input asp-for="GuestPetName" class="form-control rounded-3 py-2 fw-semibold" placeholder="VD: Bơ" id="guestPetNameInput" oninput="updateGuestInfo()" />
                                    <span asp-validation-for="GuestPetName" class="text-danger small"></span>
                                </div>
                                <div class="col-12 col-sm-4">
                                    <label class="form-label small fw-bold text-dark mb-1">Loài <span class="text-danger">*</span></label>
                                    <select asp-for="GuestSpecies" class="form-select rounded-3 py-2" id="guestSpeciesSelect" onchange="updateGuestInfo()">
                                        <option value="Chó">Chó</option>
                                        <option value="Mèo">Mèo</option>
                                        <option value="Khác">Khác</option>
                                    </select>
                                </div>
                                <div class="col-12 col-sm-4">
                                    <label class="form-label small fw-bold text-dark mb-1">Cân nặng (kg)</label>
                                    <input asp-for="GuestWeight" type="number" step="0.1" class="form-control rounded-3 py-2" placeholder="VD: 4.5" id="guestWeightInput" oninput="updateGuestInfo()" />
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-sm-6">
                                    <label class="form-label small fw-bold text-dark mb-1">Giống loài</label>
                                    <input asp-for="GuestBreed" class="form-control rounded-3 py-2" placeholder="VD: Poodle, Mèo Anh lông ngắn..." id="guestBreedInput" oninput="updateGuestInfo()" />
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="form-label small fw-bold text-dark mb-1">Tiền sử dị ứng / Lưu ý đặc biệt</label>
                                    <input asp-for="GuestAllergyNote" class="form-control rounded-3 py-2" placeholder="VD: Da nhạy cảm, nhát người lạ..." id="guestAllergyInput" oninput="updateGuestInfo()" />
                                </div>
                            </div>
                        }

                        <!-- Cảnh báo tiền sử dị ứng chuẩn mockup Image 5 -->
                        <div class="mt-3 p-3 rounded-3" id="petAllergyAlert" style="background-color: #fffbeb; border: 1px solid #fef3c7; color: #b45309; display: none;">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-exclamation-triangle-fill text-warning fs-5 flex-shrink-0"></i>
                                <div>
                                    <strong>Lưu ý: <span id="allergyPetName">Mochi</span> có tiền sử dị ứng:</strong>
                                    <div id="allergyPetContent" class="small mt-1">
                                        Thành phần ngũ cốc, sữa tắm chứa Sulfate. Nhân viên sẽ sử dụng sản phẩm thay thế không gây kích ứng cho bé.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 02. CHỌN DỊCH VỤ (6 Cards Grid) -->
                <div class="booking-card p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <div class="d-flex align-items-center gap-2">
                            <span class="step-number-badge">02</span>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">Chọn dịch vụ</h5>
                                <small class="text-muted">Có thể chọn nhiều dịch vụ cùng lúc</small>
                            </div>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold" id="selectedServiceBadge">
                            1 đã chọn
                        </span>
                    </div>

                    <div class="row g-3 mt-2" id="serviceCardsGrid">
                        @if (Model.Services.Any())
                        {
                            int sIdx = 0;
                            string[] svcIcons = { "bi-droplet-fill text-success", "bi-scissors text-secondary", "bi-house-heart text-secondary", "bi-clipboard-check text-secondary", "bi-heart-pulse text-secondary", "bi-flower1 text-secondary" };
                            foreach (var svc in Model.Services)
                            {
                                var iconClass = svcIcons[sIdx % svcIcons.Length];
                                bool isChecked = sIdx == 0 || Model.ServiceIds.Contains(svc.ServiceId);
                                <div class="col-12 col-md-6">
                                    <div class="service-selection-card @(isChecked ? "selected" : "")" onclick="toggleServiceCard(this)">
                                        <div class="rounded-3 bg-light border p-2 text-center d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <i class="bi @iconClass fs-5"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="fw-bold text-dark lh-sm">@svc.ServiceName</div>
                                                <input class="form-check-input service-check" type="checkbox" name="ServiceIds" 
                                                       value="@svc.ServiceId" data-name="@svc.ServiceName" data-price="@svc.BasePrice" 
                                                       data-duration="@svc.DurationMinutes" @(isChecked ? "checked" : "") 
                                                       onclick="event.stopPropagation(); updateBookingSummary();" />
                                            </div>
                                            <div class="text-muted small mt-1" style="font-size: 0.78rem;">@svc.Category · @svc.DurationMinutes phút</div>
                                            <div class="fw-bold text-success mt-1" style="font-size: 0.95rem;">@svc.BasePrice.ToString("N0")đ</div>
                                        </div>
                                    </div>
                                </div>
                                sIdx++;
                            }
                        }
                    </div>
                </div>

                <!-- 03. CHỌN NGÀY VÀ GIỜ -->
                <div class="booking-card p-4 mb-4">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="step-number-badge">03</span>
                        <div>
                            <h5 class="fw-bold text-dark mb-0">Chọn ngày và giờ</h5>
                            <small class="text-muted">Giờ mở cửa: 08:00 – 18:00, tất cả các ngày trong tuần</small>
                        </div>
                    </div>

                    <div class="row g-4 mt-2">
                        <!-- Mini Calendar bên trái -->
                        <div class="col-12 col-md-5">
                            <div class="mini-calendar-box">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <button type="button" class="btn btn-sm btn-light border-0" onclick="prevMonth()"><i class="bi bi-chevron-left"></i></button>
                                    <strong class="text-dark small" id="calendarMonthYear">Tháng 11, 2026</strong>
                                    <button type="button" class="btn btn-sm btn-light border-0" onclick="nextMonth()"><i class="bi bi-chevron-right"></i></button>
                                </div>
                                <div class="calendar-days-grid mb-1">
                                    <div class="calendar-day-header">T2</div>
                                    <div class="calendar-day-header">T3</div>
                                    <div class="calendar-day-header">T4</div>
                                    <div class="calendar-day-header">T5</div>
                                    <div class="calendar-day-header">T6</div>
                                    <div class="calendar-day-header text-primary">T7</div>
                                    <div class="calendar-day-header text-danger">CN</div>
                                </div>
                                <div class="calendar-days-grid" id="calendarDaysBody">
                                    <!-- Dynamic month days -->
                                </div>
                            </div>
                        </div>

                        <!-- Khung giờ trống bên phải (Sáng & Chiều) -->
                        <div class="col-12 col-md-7">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-dark small">Khung giờ trống</span>
                                <small class="text-muted" id="selectedDateDisplay">Thứ Bảy, 14/11/2026</small>
                            </div>

                            <!-- Buổi sáng -->
                            <div class="text-muted fw-bold mb-1" style="font-size: 0.72rem; letter-spacing: 0.05em;">S. BUỔI SÁNG</div>
                            <div class="row g-2 mb-3">
                                <div class="col-4"><button type="button" class="slot-pill-btn" onclick="selectSlot(this, '08:00')">08:00</button></div>
                                <div class="col-4"><button type="button" class="slot-pill-btn" onclick="selectSlot(this, '08:30')">08:30</button></div>
                                <div class="col-4"><button type="button" class="slot-pill-btn disabled" disabled>09:00</button></div>
                                <div class="col-4"><button type="button" class="slot-pill-btn" onclick="selectSlot(this, '09:30')">09:30</button></div>
                                <div class="col-4"><button type="button" class="slot-pill-btn selected" onclick="selectSlot(this, '10:00')">10:00</button></div>
                                <div class="col-4"><button type="button" class="slot-pill-btn" onclick="selectSlot(this, '11:00')">11:00</button></div>
                            </div>

                            <!-- Buổi chiều -->
                            <div class="text-muted fw-bold mb-1" style="font-size: 0.72rem; letter-spacing: 0.05em;">C. BUỔI CHIỀU</div>
                            <div class="row g-2 mb-3">
                                <div class="col-4"><button type="button" class="slot-pill-btn" onclick="selectSlot(this, '13:30')">13:30</button></div>
                                <div class="col-4"><button type="button" class="slot-pill-btn disabled" disabled>14:00</button></div>
                                <div class="col-4"><button type="button" class="slot-pill-btn" onclick="selectSlot(this, '14:30')">14:30</button></div>
                                <div class="col-4"><button type="button" class="slot-pill-btn" onclick="selectSlot(this, '15:30')">15:30</button></div>
                                <div class="col-4"><button type="button" class="slot-pill-btn disabled" disabled>16:00</button></div>
                                <div class="col-4"><button type="button" class="slot-pill-btn" onclick="selectSlot(this, '17:00')">17:00</button></div>
                            </div>

                            <!-- Legend -->
                            <div class="d-flex align-items-center gap-3 small text-muted pt-2 border-top">
                                <span class="d-flex align-items-center gap-1"><span class="d-inline-block rounded-circle bg-success" style="width: 8px; height: 8px;"></span> Đã chọn</span>
                                <span class="d-flex align-items-center gap-1"><span class="d-inline-block rounded-circle border bg-white" style="width: 8px; height: 8px;"></span> Còn trống</span>
                                <span class="d-flex align-items-center gap-1"><span class="d-inline-block rounded-circle bg-secondary" style="width: 8px; height: 8px;"></span> Đã kín</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 04. GHI CHÚ THÊM -->
                <div class="booking-card p-4 mb-4">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="step-number-badge">04</span>
                        <div>
                            <h5 class="fw-bold text-dark mb-0">Ghi chú thêm <span class="fw-normal text-muted">(Không bắt buộc)</span></h5>
                            <small class="text-muted">Tình trạng sức khỏe, tính cách hoặc yêu cầu đặc biệt của bé</small>
                        </div>
                    </div>

                    <div class="mt-3">
                        <textarea asp-for="Notes" id="bookingNotes" class="form-control rounded-3" rows="3" maxlength="500"
                                  placeholder="VD: Bé hơi nhát người lạ, xin vui lòng nhẹ nhàng khi cắt móng. Muốn tỉa lông kiểu teddy..." oninput="updateNotesCount()">@(Model.IsAuthenticated && !Model.IsStaffOrAdmin ? "Bé hơi nhát người lạ, xin nhẹ nhàng khi cắt móng." : "")</textarea>
                        
                        <!-- Quick Tag Chips -->
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            <span class="note-tag-chip" onclick="toggleNoteTag(this, 'Bé nhát người lạ')">+ Bé nhát người lạ</span>
                            <span class="note-tag-chip" onclick="toggleNoteTag(this, 'Hơi sợ nước')">+ Hơi sợ nước</span>
                            <span class="note-tag-chip" onclick="toggleNoteTag(this, 'Giữ ấm sau khi xong')">+ Giữ ấm sau khi xong</span>
                        </div>

                        <div class="text-end text-muted small mt-1" id="notesCharCounter">@(Model.IsAuthenticated && !Model.IsStaffOrAdmin ? "48/500" : "0/500")</div>
                    </div>
                </div>

                <!-- Policy agreement check -->
                <div class="p-3 rounded-3 mb-4 d-flex align-items-center gap-2" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                    <input class="form-check-input mt-0 text-success" type="checkbox" id="policyAgreement" checked required />
                    <label class="form-check-label text-dark small" for="policyAgreement">
                        Tôi đồng ý với <a href="javascript:void(0)" class="text-success fw-bold text-decoration-none">chính sách đặt & hủy lịch</a> · Hủy miễn phí trước 24 giờ.
                    </label>
                </div>

                <!-- Big CTA Submit Button -->
                <button type="submit" class="btn btn-submit-booking d-flex align-items-center justify-content-center gap-2 fs-5">
                    <i class="bi bi-calendar-check-fill"></i>
                    <span>Xác nhận đặt lịch</span>
                </button>
                <div class="text-center text-muted small mt-2">
                    <i class="bi bi-shield-check text-success me-1"></i>Thanh toán tại cửa hàng sau khi hoàn tất dịch vụ
                </div>
            </div>

            <!-- CỘT PHẢI: TÓM TẮT LỊCH HẸN & THÔNG TIN CHI NHÁNH -->
            <div class="col-12 col-lg-4">
                <div class="position-sticky" style="top: 20px;">
                    <!-- Card Tóm tắt -->
                    <div class="booking-summary-box mb-3">
                        <div class="summary-header-green">
                            <div class="text-uppercase fw-bold small" style="letter-spacing: 0.05em; opacity: 0.85;">Tóm tắt lịch hẹn</div>
                            <div class="d-flex align-items-center gap-2 mt-2">
                                <img src="https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=100&auto=format&fit=crop&q=80" 
                                     alt="Pet" class="rounded-3 border border-white border-opacity-25" style="width: 42px; height: 42px; object-fit: cover;" />
                                <div>
                                    <div class="fw-bold fs-6 lh-sm" id="sumPetName">@(Model.IsAuthenticated && !Model.IsStaffOrAdmin ? "Mochi" : "Bé cưng")</div>
                                    <small style="opacity: 0.9;" id="sumPetBreed">@(Model.IsAuthenticated && !Model.IsStaffOrAdmin ? "Mèo Anh lông ngắn · 3 tuổi" : "Chó · Giữ chỗ trực tuyến")</small>
                                </div>
                            </div>
                        </div>

                        <div class="p-3">
                            <div class="text-muted fw-bold small text-uppercase mb-2" style="font-size: 0.68rem;">Dịch vụ</div>
                            <div id="sumServiceList" class="mb-3">
                                <div class="d-flex justify-content-between align-items-center text-dark small fw-semibold">
                                    <span>• Tắm vệ sinh</span>
                                    <span>150.000đ</span>
                                </div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="p-2 rounded-3 bg-light border">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.65rem;">Ngày</small>
                                        <strong class="text-dark small" id="sumDate">14/11/2026</strong>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 rounded-3 bg-light border">
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.65rem;">Giờ hẹn</small>
                                        <strong class="text-dark small" id="sumTime">10:00</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center text-muted small mb-3">
                                <span><i class="bi bi-hourglass-split me-1"></i>Thời lượng dự kiến</span>
                                <strong class="text-dark" id="sumDuration">1 giờ</strong>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                <span class="fw-bold text-dark">Tạm tính</span>
                                <span class="fs-4 fw-bold text-success" id="sumTotalPrice">150.000đ</span>
                            </div>
                        </div>
                    </div>

                    <!-- Card Chi nhánh -->
                    <div class="booking-card p-3 mb-3 d-flex align-items-start gap-3">
                        <div class="rounded-circle bg-success bg-opacity-10 text-success p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-geo-alt-fill fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark lh-sm">PawHaven Thảo Điền</div>
                            <small class="text-muted d-block mt-1">42 Xuân Thủy, P. Thảo Điền, TP. Thủ Đức</small>
                            <a href="javascript:void(0)" class="text-success small fw-semibold text-decoration-none mt-1 d-inline-block">Đổi chi nhánh ›</a>
                        </div>
                    </div>

                    <!-- Card Hỗ trợ Hotline -->
                    <div class="booking-card p-3 d-flex align-items-start gap-3" style="background-color: #f0fdf4; border-color: #bbf7d0;">
                        <div class="rounded-circle bg-success text-white p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-telephone-fill"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark lh-sm">Cần hỗ trợ?</div>
                            <small class="text-muted d-block mt-1">Hotline: <strong class="text-success">1900 6868</strong> (8:00 – 21:00)</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const petsByCustomer = @Json.Serialize(Model.PetsByCustomer);
        let selectedYear = 2026;
        let selectedMonth = 10; // Tháng 11 (0-indexed: 10)
        let selectedDay = 14;

        function renderCalendar() {
            const monthNames = ["Tháng 1", "Tháng 2", "Tháng 3", "Tháng 4", "Tháng 5", "Tháng 6", "Tháng 7", "Tháng 8", "Tháng 9", "Tháng 10", "Tháng 11", "Tháng 12"];
            document.getElementById('calendarMonthYear').textContent = `${monthNames[selectedMonth]}, ${selectedYear}`;

            const container = document.getElementById('calendarDaysBody');
            container.innerHTML = '';

            const firstDayIndex = new Date(selectedYear, selectedMonth, 1).getDay(); // 0 is Sunday
            const daysInMonth = new Date(selectedYear, selectedMonth + 1, 0).getDate();
            const startOffset = (firstDayIndex === 0 ? 6 : firstDayIndex - 1); // Monday is 0

            // Empty cells before first day
            for (let i = 0; i < startOffset; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.className = 'calendar-day-cell disabled';
                container.appendChild(emptyCell);
            }

            // Days of the month
            for (let d = 1; d <= daysInMonth; d++) {
                const cell = document.createElement('div');
                cell.className = 'calendar-day-cell';
                cell.textContent = d;
                if (d === selectedDay) {
                    cell.classList.add('selected');
                }
                cell.onclick = function() {
                    document.querySelectorAll('.calendar-day-cell').forEach(c => c.classList.remove('selected'));
                    cell.classList.add('selected');
                    selectedDay = d;
                    onDateSelected(selectedYear, selectedMonth + 1, selectedDay);
                };
                container.appendChild(cell);
            }
        }

        function prevMonth() {
            selectedMonth--;
            if (selectedMonth < 0) {
                selectedMonth = 11;
                selectedYear--;
            }
            renderCalendar();
        }

        function nextMonth() {
            selectedMonth++;
            if (selectedMonth > 11) {
                selectedMonth = 0;
                selectedYear++;
            }
            renderCalendar();
        }

        function onDateSelected(year, month, day) {
            const formatted = `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
            document.getElementById('appointmentDateInput').value = formatted;
            document.getElementById('selectedDateDisplay').textContent = `Thứ Bảy, ${day}/${month}/${year}`;
            document.getElementById('sumDate').textContent = `${day}/${month}/${year}`;
        }

        function selectSlot(btn, time) {
            document.querySelectorAll('.slot-pill-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            document.getElementById('startTimeInput').value = time;
            document.getElementById('sumTime').textContent = time;
        }

        function toggleServiceCard(card) {
            const chk = card.querySelector('.service-check');
            chk.checked = !chk.checked;
            if (chk.checked) {
                card.classList.add('selected');
            } else {
                card.classList.remove('selected');
            }
            updateBookingSummary();
        }

        function updateBookingSummary() {
            const checkedBoxes = Array.from(document.querySelectorAll('.service-check:checked'));
            document.getElementById('selectedServiceBadge').textContent = `${checkedBoxes.length} đã chọn`;

            const listContainer = document.getElementById('sumServiceList');
            listContainer.innerHTML = '';
            let total = 0;
            let totalMinutes = 0;

            checkedBoxes.forEach(chk => {
                const name = chk.getAttribute('data-name');
                const price = parseFloat(chk.getAttribute('data-price')) || 0;
                const duration = parseInt(chk.getAttribute('data-duration')) || 30;
                total += price;
                totalMinutes += duration;

                const row = document.createElement('div');
                row.className = 'd-flex justify-content-between align-items-center text-dark small fw-semibold mb-1';
                row.innerHTML = `<span>• ${name}</span><span>${price.toLocaleString('vi-VN')}đ</span>`;
                listContainer.appendChild(row);
            });

            if (checkedBoxes.length === 0) {
                listContainer.innerHTML = '<div class="text-muted small">Chưa chọn dịch vụ nào</div>';
            }

            document.getElementById('sumTotalPrice').textContent = total.toLocaleString('vi-VN') + 'đ';
            const hours = Math.floor(totalMinutes / 60);
            const mins = totalMinutes % 60;
            document.getElementById('sumDuration').textContent = hours > 0 ? `${hours} giờ ${mins > 0 ? mins + ' phút' : ''}` : `${mins} phút`;
        }

        function populatePetsForCustomer(custId) {
            const petSelect = document.getElementById('petSelect');
            if (!petSelect) return;
            petSelect.innerHTML = '';

            const list = petsByCustomer && petsByCustomer[custId] ? petsByCustomer[custId] : [];
            if (list.length === 0) {
                const opt = document.createElement('option');
                opt.value = '';
                opt.textContent = '-- Chưa có thú cưng --';
                petSelect.appendChild(opt);
                document.getElementById('sumPetName').textContent = 'Bé cưng';
                document.getElementById('sumPetBreed').textContent = 'Chưa chọn';
                const allergyBox = document.getElementById('petAllergyAlert');
                if (allergyBox) allergyBox.style.display = 'none';
                return;
            }

            list.forEach((p, idx) => {
                const opt = document.createElement('option');
                opt.value = p.petId;
                opt.textContent = `${p.petName} - ${p.breed || p.species} (${p.weight} kg)`;
                opt.setAttribute('data-name', p.petName);
                opt.setAttribute('data-breed', p.breed || p.species);
                opt.setAttribute('data-weight', p.weight);
                opt.setAttribute('data-allergy', p.allergyNote || '');
                if (idx === 0) opt.selected = true;
                petSelect.appendChild(opt);
            });

            onPetChanged();
        }

        function onPetChanged() {
            const petSelect = document.getElementById('petSelect');
            if (!petSelect || petSelect.selectedIndex < 0) return;
            const opt = petSelect.options[petSelect.selectedIndex];
            if (!opt || !opt.value) return;

            const petName = opt.getAttribute('data-name') || opt.text.split(' - ')[0];
            const breed = opt.getAttribute('data-breed') || '';
            const weight = opt.getAttribute('data-weight') || '';
            const allergy = opt.getAttribute('data-allergy') || '';

            document.getElementById('sumPetName').textContent = petName;
            document.getElementById('sumPetBreed').textContent = `${breed}${weight ? ' · ' + weight + ' kg' : ''}`;

            const allergyBox = document.getElementById('petAllergyAlert');
            if (allergyBox) {
                if (allergy && allergy.trim().length > 0) {
                    document.getElementById('allergyPetName').textContent = petName;
                    document.getElementById('allergyPetContent').textContent = allergy;
                    allergyBox.style.display = 'block';
                } else {
                    allergyBox.style.display = 'none';
                }
            }
        }

        function updateGuestInfo() {
            const petNameInput = document.getElementById('guestPetNameInput');
            const speciesSelect = document.getElementById('guestSpeciesSelect');
            const breedInput = document.getElementById('guestBreedInput');
            const weightInput = document.getElementById('guestWeightInput');
            const allergyInput = document.getElementById('guestAllergyInput');

            const petName = (petNameInput && petNameInput.value.trim()) || 'Bé cưng';
            const species = (speciesSelect && speciesSelect.value) || 'Chó';
            const breed = (breedInput && breedInput.value.trim()) || species;
            const weight = (weightInput && weightInput.value.trim()) || '';
            const allergy = (allergyInput && allergyInput.value.trim()) || '';

            document.getElementById('sumPetName').textContent = petName;
            document.getElementById('sumPetBreed').textContent = `${breed}${weight ? ' · ' + weight + ' kg' : ''}`;

            const allergyBox = document.getElementById('petAllergyAlert');
            if (allergyBox) {
                if (allergy && allergy.length > 0) {
                    document.getElementById('allergyPetName').textContent = petName;
                    document.getElementById('allergyPetContent').textContent = allergy;
                    allergyBox.style.display = 'block';
                } else {
                    allergyBox.style.display = 'none';
                }
            }
        }

        function toggleNoteTag(chip, text) {
            chip.classList.toggle('active');
            const textarea = document.getElementById('bookingNotes');
            let current = textarea.value.trim();
            if (chip.classList.contains('active')) {
                textarea.value = current.length > 0 ? current + '. ' + text : text;
            } else {
                textarea.value = current.replace(text, '').replace(/\.\s*\.\s*/g, '. ').replace(/^\.\s*|\s*\.\s*$/g, '').trim();
            }
            updateNotesCount();
        }

        function updateNotesCount() {
            const val = document.getElementById('bookingNotes').value;
            document.getElementById('notesCharCounter').textContent = `${val.length}/500`;
        }

        document.addEventListener("DOMContentLoaded", function() {
            renderCalendar();
            const custSelect = document.getElementById('customerSelect');
            if (custSelect) {
                const initCustId = custSelect.value || (custSelect.tagName === 'SELECT' ? custSelect.options[1]?.value : '');
                if (initCustId) {
                    if (custSelect.tagName === 'SELECT') custSelect.value = initCustId;
                    populatePetsForCustomer(initCustId);
                }
                custSelect.addEventListener('change', () => populatePetsForCustomer(custSelect.value));
            } else {
                updateGuestInfo();
            }
            updateBookingSummary();
            updateNotesCount();
        });
    </script>
}