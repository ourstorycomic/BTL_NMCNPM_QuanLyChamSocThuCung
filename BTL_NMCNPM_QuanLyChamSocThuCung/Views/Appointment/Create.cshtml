@model BTL_NMCNPM_QuanLyChamSocThuCung.ViewModels.AppointmentCreateViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Đặt lịch hẹn";
}
<link rel="stylesheet" href="~/css/appointment.css" />

<div class="appointment-page">
    <div class="appointment-heading">
        <div>
            <h2>Đặt lịch hẹn</h2>
            <p>Chọn khách hàng, thú cưng, dịch vụ và khung giờ còn trống.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    }

    <form method="post" id="bookingForm" novalidate>
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="appointment-card">
                    <h5>1. Khách hàng và thú cưng</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label">Khách hàng</label>
                            <select asp-for="CustomerId" id="customerSelect" class="form-select">
                                <option value="">-- Chọn khách hàng --</option>
                                @foreach (var customer in Model.Customers)
                                {
                                    <option value="@customer.Id">@customer.CustomerName - @customer.PhoneNumber</option>
                                }
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PetId" class="form-label">Thú cưng</label>
                            <select asp-for="PetId" id="petSelect" class="form-select" disabled data-selected="@Model.PetId">
                                <option value="">-- Chọn khách hàng trước --</option>
                            </select>
                            <span asp-validation-for="PetId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div id="petAllergyBox" class="appointment-allergy mt-3 d-none" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>
                            <strong>Cảnh báo dị ứng</strong>
                            <div id="petAllergyText"></div>
                        </div>
                    </div>
                </div>

                <div class="appointment-card">
                    <h5>2. Chọn ngày và giờ</h5>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="AppointmentDate" class="form-label">Ngày hẹn</label>
                            <input asp-for="AppointmentDate" type="date" id="dateInput" class="form-control"
                                   asp-format="{0:yyyy-MM-dd}" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Khung giờ trống</label>
                            <div id="slotBox" class="slot-grid">
                                <div class="slot-hint">Chọn ngày và dịch vụ để xem giờ trống.</div>
                            </div>
                            <input asp-for="StartTime" type="hidden" id="startTimeInput" />
                            <span asp-validation-for="StartTime" class="text-danger small d-block"></span>
                        </div>
                    </div>
                </div>

                <div class="appointment-card">
                    <h5>3. Chọn dịch vụ</h5>
                    <span asp-validation-for="ServiceIds" class="text-danger small d-block mb-2"></span>
                    <div class="service-grid">
                        @foreach (var service in Model.Services)
                        {
                            <label class="service-card@(Model.ServiceIds.Contains(service.ServiceId) ? " selected" : "")">
                                <input class="service-check" type="checkbox" name="ServiceIds" value="@service.ServiceId"
                                       data-duration="@service.DurationMinutes"
                                       data-price="@service.BasePrice.ToString(CultureInfo.InvariantCulture)"
                                       checked="@(Model.ServiceIds.Contains(service.ServiceId) ? "checked" : null)" />
                                <span class="service-body">
                                    <span class="service-name">@service.ServiceName</span>
                                    <span class="service-meta">@service.Category · @service.DurationMinutes phút · @service.BasePrice.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) đ</span>
                                </span>
                            </label>
                        }
                    </div>
                    @if (Model.Services.Count == 0)
                    {
                        <p class="text-muted mb-0">Chưa có dịch vụ nào đang hoạt động.</p>
                    }
                </div>

                <div class="appointment-card">
                    <h5>4. Ghi chú</h5>
                    <textarea asp-for="Notes" class="form-control" rows="3"
                              placeholder="Tình trạng thú cưng, yêu cầu đặc biệt..."></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="summary-card">
                    <h5>Tóm tắt lịch hẹn</h5>
                    <div class="summary-row">
                        <span>Thú cưng</span>
                        <strong id="sumPet">—</strong>
                    </div>
                    <div class="summary-row">
                        <span>Thời lượng</span>
                        <strong id="sumDuration">30 phút</strong>
                    </div>
                    <div class="summary-row">
                        <span>Tạm tính</span>
                        <strong id="sumPrice">0 đ</strong>
                    </div>
                    <div class="summary-row">
                        <span>Giờ hẹn</span>
                        <strong id="sumTime">Chưa chọn</strong>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mt-3">Xác nhận đặt lịch</button>
                    <p class="summary-note">Lịch hẹn sau khi tạo sẽ ở trạng thái Chờ xác nhận.</p>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const petsByCustomer = @Json.Serialize(Model.PetsByCustomer);
            const slotsUrl = '@Url.Action("Slots", "Appointment")';

            const form = document.getElementById('bookingForm');
            const customerSelect = document.getElementById('customerSelect');
            const petSelect = document.getElementById('petSelect');
            const dateInput = document.getElementById('dateInput');
            const slotBox = document.getElementById('slotBox');
            const startTimeInput = document.getElementById('startTimeInput');
            const sumPet = document.getElementById('sumPet');
            const sumDuration = document.getElementById('sumDuration');
            const sumPrice = document.getElementById('sumPrice');
            const sumTime = document.getElementById('sumTime');
            const petAllergyBox = document.getElementById('petAllergyBox');
            const petAllergyText = document.getElementById('petAllergyText');

            let slotRequestId = 0;

            function serviceChecks() {
                return Array.from(document.querySelectorAll('.service-check:checked'));
            }

            function selectedServiceIds() {
                return serviceChecks().map(function (el) { return el.value; });
            }

            function clearValidationFor(field) {
                const span = document.querySelector('[data-valmsg-for="' + field + '"]');
                if (span) span.textContent = '';
            }

            function clearValueError() {
                clearValidationFor('StartTime');
                const hint = document.getElementById('slotClientError');
                if (hint) hint.remove();
            }

            function updateSummary() {
                let duration = 0;
                let price = 0;

                serviceChecks().forEach(function (el) {
                    duration += parseInt(el.dataset.duration || '0', 10);
                    price += parseFloat(el.dataset.price || '0');
                });

                if (duration <= 0) duration = 30;

                sumDuration.textContent = duration + ' phút';
                sumPrice.textContent = price.toLocaleString('vi-VN') + ' đ';
                return duration;
            }

            function updatePetSummary() {
                const option = petSelect.options[petSelect.selectedIndex];
                sumPet.textContent = option && option.value ? option.text : '—';

                const pet = option && option.value
                    ? (petsByCustomer[customerSelect.value] || []).find(function (p) {
                        return p.petId === option.value;
                    })
                    : null;

                const allergy = pet && pet.allergyNote ? pet.allergyNote.trim() : '';

                if (allergy) {
                    petAllergyText.textContent = allergy;
                    petAllergyBox.classList.remove('d-none');
                } else {
                    petAllergyText.textContent = '';
                    petAllergyBox.classList.add('d-none');
                }
            }

            function fillPets() {
                const customerId = customerSelect.value;
                const previous = petSelect.dataset.selected || petSelect.value || '';

                petSelect.innerHTML = '';

                if (!customerId) {
                    petSelect.disabled = true;
                    petSelect.appendChild(new Option('-- Chọn khách hàng trước --', ''));
                    return;
                }

                const pets = petsByCustomer[customerId] || [];
                petSelect.disabled = false;
                petSelect.appendChild(new Option('-- Chọn thú cưng --', ''));

                pets.forEach(function (pet) {
                    petSelect.appendChild(new Option(pet.displayName, pet.petId));
                });

                if (previous) {
                    petSelect.value = previous;
                    if (petSelect.value !== previous) petSelect.value = '';
                }

                updatePetSummary();
            }

            function renderSlots(slots, previous) {
                slotBox.innerHTML = '';

                if (!slots || slots.length === 0) {
                    slotBox.innerHTML = '<div class="slot-hint">Không còn khung giờ phù hợp trong ngày này.</div>';
                    if (previous) {
                        startTimeInput.value = '';
                        sumTime.textContent = 'Chưa chọn';
                    }
                    return;
                }

                slots.forEach(function (slot) {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'slot-btn' + (slot.available ? '' : ' slot-disabled');
                    button.textContent = slot.value;
                    button.disabled = !slot.available;
                    button.title = slot.available
                        ? slot.label
                        : (slot.reason === 'past' ? 'Đã qua' : 'Đã có lịch hẹn khác');

                    if (slot.available) {
                        button.addEventListener('click', function () {
                            chooseSlot(button, slot);
                        });
                    }

                    slotBox.appendChild(button);
                });

                if (previous) {
                    const match = Array.from(slotBox.querySelectorAll('.slot-btn'))
                        .find(function (b) { return !b.disabled && b.textContent === previous; });

                    if (match) {
                        match.click();
                    } else {
                        startTimeInput.value = '';
                        sumTime.textContent = 'Chưa chọn';
                    }
                }
            }

            function chooseSlot(button, slot) {
                slotBox.querySelectorAll('.slot-btn.active').forEach(function (b) {
                    b.classList.remove('active');
                });

                button.classList.add('active');
                startTimeInput.value = slot.value;
                sumTime.textContent = slot.label;

                clearValueError();
            }

            async function refreshSlots(keepSelection) {
                const previous = keepSelection ? startTimeInput.value : '';
                const date = dateInput.value;

                if (!keepSelection) {
                    startTimeInput.value = '';
                    sumTime.textContent = 'Chưa chọn';
                    clearValueError();
                }

                if (!date) {
                    slotBox.innerHTML = '<div class="slot-hint">Chọn ngày hẹn để xem giờ trống.</div>';
                    return;
                }

                const ids = selectedServiceIds();
                const url = slotsUrl + '?date=' + encodeURIComponent(date) +
                    '&serviceIds=' + encodeURIComponent(ids.join(','));

                const requestId = ++slotRequestId;
                slotBox.innerHTML = '<div class="slot-hint">Đang tải khung giờ...</div>';

                try {
                    const response = await fetch(url, { headers: { 'Accept': 'application/json' } });
                    if (!response.ok) throw new Error('request failed');

                    const data = await response.json();
                    if (requestId !== slotRequestId) return;

                    renderSlots(data.slots, previous);
                } catch (error) {
                    if (requestId !== slotRequestId) return;
                    slotBox.innerHTML = '<div class="slot-hint text-danger">Không tải được khung giờ. Vui lòng thử lại.</div>';
                }
            }

            customerSelect.addEventListener('change', function () {
                petSelect.dataset.selected = '';
                fillPets();
            });

            petSelect.addEventListener('change', updatePetSummary);

            document.querySelectorAll('.service-check').forEach(function (checkbox) {
                checkbox.addEventListener('change', function () {
                    const card = checkbox.closest('.service-card');
                    if (card) card.classList.toggle('selected', checkbox.checked);

                    clearValidationFor('ServiceIds');
                    const serviceError = document.getElementById('serviceClientError');
                    if (serviceError) serviceError.remove();

                    updateSummary();
                    refreshSlots(false);
                });
            });

            dateInput.addEventListener('change', function () {
                refreshSlots(false);
            });

            form.addEventListener('submit', function (event) {
                let firstInvalid = null;

                if (selectedServiceIds().length === 0) {
                    let error = document.getElementById('serviceClientError');
                    if (!error) {
                        error = document.createElement('div');
                        error.id = 'serviceClientError';
                        error.className = 'text-danger small mt-2';
                        error.textContent = 'Vui lòng chọn ít nhất một dịch vụ.';
                        document.querySelector('.service-grid').insertAdjacentElement('afterend', error);
                    }
                    firstInvalid = firstInvalid || document.querySelector('.service-grid');
                }

                if (!startTimeInput.value) {
                    let error = document.getElementById('slotClientError');
                    if (!error) {
                        error = document.createElement('div');
                        error.id = 'slotClientError';
                        error.className = 'text-danger small mt-2';
                        error.textContent = 'Vui lòng chọn một khung giờ trống.';
                        slotBox.insertAdjacentElement('afterend', error);
                    }
                    firstInvalid = firstInvalid || slotBox;
                }

                if (firstInvalid) {
                    event.preventDefault();
                    firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            });

            // Khôi phục trạng thái khi server trả lại form kèm lỗi.
            fillPets();
            updateSummary();
            refreshSlots(true);
        })();
    </script>
}
