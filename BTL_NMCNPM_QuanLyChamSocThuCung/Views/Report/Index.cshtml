@model BTL_NMCNPM_QuanLyChamSocThuCung.ViewModels.ReportDashboardViewModel
@{
    ViewData["Title"] = "Báo cáo Thống kê Doanh thu";
}

<!-- CDN Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- Header & Time Filter Bar -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">Báo cáo & Thống kê</li>
            </ol>
        </nav>
        <h3 class="fw-bold text-dark mb-0 d-flex align-items-center">
            <span class="rounded-3 bg-success bg-opacity-10 text-success p-2 d-inline-flex align-items-center justify-content-center me-2" style="width: 38px; height: 38px;">
                <i class="bi bi-graph-up-arrow"></i>
            </span>
            Báo cáo Thống kê Doanh thu (UC13)
        </h3>
        <p class="text-muted small mb-0 ms-1">
            Kỳ báo cáo: Từ <strong>@Model.FromDate.ToString("dd/MM/yyyy")</strong> đến <strong>@Model.ToDate.ToString("dd/MM/yyyy")</strong>
        </p>
    </div>

    <!-- Nút hành động Xuất Excel & In -->
    <div class="d-flex align-items-center gap-2">
        <a asp-action="ExportCsv" asp-route-range="@Model.TimeRange" 
           asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" 
           asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")" 
           class="btn btn-paw-outline shadow-sm">
            <i class="bi bi-file-earmark-excel-fill text-success me-1"></i>Xuất Excel (.csv)
        </a>
        <button type="button" onclick="window.print()" class="btn btn-light border shadow-sm">
            <i class="bi bi-printer me-1"></i>In báo cáo
        </button>
    </div>
</div>

<!-- Bộ lọc khoảng thời gian -->
<div class="paw-card p-3 mb-4 bg-white">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-lg-5 col-md-6">
            <div class="btn-group w-100" role="group">
                <a asp-action="Index" asp-route-range="today" class="btn btn-sm @(Model.TimeRange == "today" ? "btn-success" : "btn-light border")">Hôm nay</a>
                <a asp-action="Index" asp-route-range="7days" class="btn btn-sm @(Model.TimeRange == "7days" ? "btn-success" : "btn-light border")">7 ngày qua</a>
                <a asp-action="Index" asp-route-range="month" class="btn btn-sm @(Model.TimeRange == "month" ? "btn-success" : "btn-light border")">Tháng này</a>
            </div>
        </div>

        <div class="col-lg-7 col-md-6">
            <div class="d-flex align-items-center gap-2">
                <input type="hidden" name="range" value="custom" />
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light">Từ</span>
                    <input type="date" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light">Đến</span>
                    <input type="date" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <button type="submit" class="btn btn-sm btn-paw-primary px-3 text-nowrap">Xem</button>
            </div>
        </div>
    </form>
</div>

<!-- 4 THẺ CHỈ SỐ KPI DOANH NGHIỆP -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="paw-card p-4">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Tổng doanh thu</span>
                <span class="badge rounded-circle p-2 bg-success bg-opacity-10 text-success">
                    <i class="bi bi-wallet2 fs-5"></i>
                </span>
            </div>
            <div class="fs-2 fw-bold text-dark">@Model.TotalRevenue.ToString("N0") <small class="fs-6 text-muted">đ</small></div>
            <small class="text-success fw-medium"><i class="bi bi-check-circle-fill me-1"></i>Doanh thu thực thu</small>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="paw-card p-4">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Hóa đơn đã thu</span>
                <span class="badge rounded-circle p-2 bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-receipt fs-5"></i>
                </span>
            </div>
            <div class="fs-2 fw-bold text-dark">@Model.TotalPaidInvoices <small class="fs-6 text-muted">đơn</small></div>
            <small class="text-muted">Lượt khách phục vụ</small>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="paw-card p-4">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Giá trị đơn TB (AOV)</span>
                <span class="badge rounded-circle p-2 bg-info bg-opacity-10 text-info">
                    <i class="bi bi-pie-chart-fill fs-5"></i>
                </span>
            </div>
            <div class="fs-2 fw-bold text-dark">@Model.AverageOrderValue.ToString("N0") <small class="fs-6 text-muted">đ</small></div>
            <small class="text-muted">Trung bình mỗi bé cưng</small>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="paw-card p-4">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Doanh thu phụ phí</span>
                <span class="badge rounded-circle p-2 bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-plus-slash-minus fs-5"></i>
                </span>
            </div>
            <div class="fs-2 fw-bold text-warning-emphasis">@Model.TotalSurcharge.ToString("N0") <small class="fs-6 text-muted">đ</small></div>
            <small class="text-muted">Gỡ rối, ve rận, lưu chuồng</small>
        </div>
    </div>
</div>

<!-- BIỂU ĐỒ DOANH THU & PHÂN BỔ DỊCH VỤ -->
<div class="row g-4 mb-4">
    <!-- Biểu đồ đường xu hướng doanh thu -->
    <div class="col-lg-8">
        <div class="paw-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-bar-chart-line-fill text-success me-2"></i>Xu hướng Doanh thu theo thời gian
                    </h5>
                    <small class="text-muted">Biểu đồ thể hiện biến động doanh thu và số lượng đơn hàng</small>
                </div>
            </div>
            <div style="height: 320px;">
                <canvas id="revenueTrendChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Biểu đồ tròn cơ cấu phương thức thanh toán -->
    <div class="col-lg-4">
        <div class="paw-card p-4 h-100">
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-credit-card-2-back-fill text-primary me-2"></i>Phương thức thanh toán
            </h5>
            <small class="text-muted d-block mb-3">Tỷ lệ tiền mặt và chuyển khoản QR</small>
            
            <div style="height: 220px; position: relative;">
                <canvas id="paymentMethodChart"></canvas>
            </div>

            <div class="mt-3 pt-3 border-top small">
                <div class="d-flex justify-content-between mb-1">
                    <span><i class="bi bi-circle-fill text-primary me-1"></i>Chuyển khoản QR:</span>
                    <strong class="text-dark">@Model.QrRevenue.ToString("N0") đ</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span><i class="bi bi-circle-fill text-success me-1"></i>Tiền mặt tại quầy:</span>
                    <strong class="text-dark">@Model.CashRevenue.ToString("N0") đ</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- TOP DỊCH VỤ & BẢNG KÊ HÓA ĐƠN -->
<div class="row g-4 mb-4">
    <!-- Top 5 dịch vụ sinh lời cao nhất -->
    <div class="col-lg-5">
        <div class="paw-card p-4 h-100">
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-trophy-fill text-warning me-2"></i>Top dịch vụ được chuộng nhất
            </h5>
            <small class="text-muted d-block mb-3">Dịch vụ đóng góp nhiều doanh thu nhất</small>

            @if (Model.TopServices == null || !Model.TopServices.Any())
            {
                <div class="text-center py-4 text-muted">Chưa có dữ liệu dịch vụ trong kỳ này.</div>
            }
            else
            {
                <div class="vstack gap-3">
                    @foreach (var s in Model.TopServices)
                    {
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-1 small">
                                <span class="fw-bold text-dark">@s.ServiceName <span class="badge bg-light text-secondary border">@s.Category</span></span>
                                <strong class="text-success">@s.TotalRevenue.ToString("N0") đ (@s.UsageCount lượt)</strong>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: @s.Percentage%;" aria-valuenow="@s.Percentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Danh sách hóa đơn chi tiết trong kỳ -->
    <div class="col-lg-7">
        <div class="paw-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-card-checklist text-success me-2"></i>Chi tiết các giao dịch trong kỳ
                    </h5>
                    <small class="text-muted">Tổng cộng @Model.RecentInvoices.Count giao dịch hoàn tất</small>
                </div>
            </div>

            <div class="table-responsive" style="max-height: 340px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>MÃ HÓA ĐƠN</th>
                            <th>THỜI GIAN</th>
                            <th>KHÁCH HÀNG</th>
                            <th>HÌNH THỨC</th>
                            <th class="text-end">TỔNG TIỀN</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentInvoices.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">Không có giao dịch nào trong khoảng thời gian này.</td>
                            </tr>
                        }
                        @foreach (var inv in Model.RecentInvoices)
                        {
                            <tr>
                                <td><strong class="text-dark">@inv.InvoiceCode</strong></td>
                                <td>@inv.PaymentTime.ToString("dd/MM HH:mm")</td>
                                <td>
                                    <div class="fw-semibold">@inv.CustomerName</div>
                                    <small class="text-muted">@inv.PetName</small>
                                </td>
                                <td>
                                    <span class="badge @(inv.PaymentMethod == "QRCode" ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-secondary-subtle text-secondary border")">
                                        @(inv.PaymentMethod == "QRCode" ? "Mã QR" : "Tiền mặt")
                                    </span>
                                </td>
                                <td class="text-end fw-bold text-success">@inv.TotalAmount.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    // 1. Biểu đồ đường xu hướng doanh thu
    const labels = @Json.Serialize(Model.ChartLabels);
    const revenueData = @Json.Serialize(Model.ChartRevenueData);
    const orderData = @Json.Serialize(Model.ChartOrderCountData);

    const ctxRevenue = document.getElementById('revenueTrendChart').getContext('2d');
    new Chart(ctxRevenue, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Doanh thu (VNĐ)',
                    data: revenueData,
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.12)',
                    fill: true,
                    tension: 0.35,
                    borderWidth: 2.5,
                    yAxisID: 'y'
                },
                {
                    label: 'Số đơn hoàn thành',
                    data: orderData,
                    borderColor: '#3b82f6',
                    backgroundColor: '#3b82f6',
                    type: 'bar',
                    borderRadius: 6,
                    barThickness: 16,
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    type: 'linear',
                    position: 'left',
                    ticks: {
                        callback: function(val) { return val.toLocaleString('vi-VN') + ' đ'; }
                    },
                    grid: { color: '#f1f5f9' }
                },
                y1: {
                    type: 'linear',
                    position: 'right',
                    ticks: { stepSize: 1 },
                    grid: { drawOnChartArea: false }
                },
                x: {
                    grid: { color: '#f1f5f9' }
                }
            },
            plugins: {
                legend: { position: 'top' }
            }
        }
    });

    // 2. Biểu đồ tròn phương thức thanh toán
    const cashTotal = @Model.CashRevenue;
    const qrTotal = @Model.QrRevenue;
    const ctxPayment = document.getElementById('paymentMethodChart').getContext('2d');
    new Chart(ctxPayment, {
        type: 'doughnut',
        data: {
            labels: ['Mã QR', 'Tiền mặt'],
            datasets: [{
                data: [qrTotal, cashTotal],
                backgroundColor: ['#3b82f6', '#10b981'],
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });
</script>
