@{
    ViewData["Title"] = "Không có quyền truy cập (403)";
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value
                   ?? Context.Session.GetString("UserRole")
                   ?? Context.Request.Cookies["UserRole"]
                   ?? "Khách";
    var userName = User.Identity?.Name
                   ?? Context.Session.GetString("FullName")
                   ?? Context.Request.Cookies["FullName"]
                   ?? "Người dùng";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 p-md-5">
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger" style="width: 80px; height: 80px;">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </div>
                </div>

                <span class="badge bg-danger-subtle text-danger fw-semibold px-3 py-2 rounded-pill mx-auto mb-3">
                    Lỗi 403 · Access Denied
                </span>

                <h3 class="fw-bold text-dark mb-2">Giới hạn quyền truy cập</h3>
                <p class="text-muted mb-4">
                    Tài khoản <strong>@userName</strong> (Vai trò: <span class="badge bg-secondary-subtle text-secondary">@userRole</span>) không có quyền truy cập vào chức năng hoặc trang quản trị này.
                </p>

                <div class="alert alert-light border rounded-3 text-start small mb-4">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-info-circle text-primary mt-1"></i>
                        <div>
                            <strong>Chính sách phân quyền hệ thống PawHaven:</strong>
                            <ul class="mb-0 mt-1 ps-3 text-muted">
                                <li><strong>Quản trị viên (Admin):</strong> Báo cáo doanh thu, quản lý danh mục dịch vụ.</li>
                                <li><strong>Nhân viên (Staff):</strong> Tiếp nhận quầy, cập nhật tiến độ, tính tiền & hóa đơn.</li>
                                <li><strong>Khách hàng (Customer):</strong> Đặt lịch hẹn, quản lý hồ sơ thú cưng cá nhân.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-paw-primary px-4 py-2">
                        <i class="bi bi-house-door me-1"></i>Về trang chủ
                    </a>
                    <a asp-controller="Account" asp-action="DangXuat" class="btn btn-paw-outline px-4 py-2">
                        <i class="bi bi-arrow-repeat me-1"></i>Đăng xuất / Đổi tài khoản
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
