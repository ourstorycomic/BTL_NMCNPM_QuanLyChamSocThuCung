@model BTL_NMCNPM_QuanLyChamSocThuCung.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "PawHaven - Hệ thống Quản lý Chăm sóc Thú cưng Tiêu chuẩn 5 Sao";
}

<div class="container py-2">
    <!-- 1. HERO BANNER CHÍNH -->
    <section class="hero-section mb-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <div class="hero-tag mb-3">
                    <i class="bi bi-shield-check text-success"></i>
                    <span>HỆ THỐNG QUẢN LÝ & CHĂM SÓC THÚ CƯNG 5 SAO</span>
                </div>
                <h1 class="hero-title mb-3">
                    Mỗi bé cưng đều xứng đáng được <span class="text-success">yêu thương trọn vẹn</span>.
                </h1>
                <p class="hero-desc mb-4">
                    PawHaven mang đến giải pháp chăm sóc thú cưng toàn diện: Đặt lịch trực tuyến 60 giây, cập nhật hình ảnh tiến độ chăm sóc trực tiếp thời gian thực, quản lý sổ tiêm chủng điện tử và hóa đơn minh bạch.
                </p>

                <div class="d-flex flex-wrap align-items-center gap-3">
                    <a asp-controller="Appointment" asp-action="Create" class="btn btn-paw-primary px-4 py-3 fs-6 shadow">
                        <i class="bi bi-calendar2-check-fill me-2"></i>Đặt lịch chăm sóc ngay
                    </a>
                    <a asp-controller="Service" asp-action="Index" class="btn btn-paw-outline px-4 py-3 fs-6">
                        <i class="bi bi-tag-fill me-2"></i>Bảng giá dịch vụ
                    </a>
                </div>

                <div class="d-flex align-items-center gap-4 mt-4 pt-3 border-top">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <span class="small fw-semibold text-secondary">Không cần xếp hàng</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-camera-fill text-success fs-5"></i>
                        <span class="small fw-semibold text-secondary">Xem ảnh trực tiếp</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock-fill text-success fs-5"></i>
                        <span class="small fw-semibold text-secondary">An toàn chuẩn y tế</span>
                    </div>
                </div>
            </div>

            <!-- Cột minh họa thú cưng PawHaven -->
            <div class="col-lg-5">
                <div class="hero-visual-card">
                    <!-- Bubble 1: Số lượng chăm sóc -->
                    <div class="stat-bubble stat-bubble-top">
                        <span class="rounded-circle bg-success bg-opacity-10 text-success p-2 d-inline-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                            <i class="bi bi-heart-pulse-fill"></i>
                        </span>
                        <div>
                            <div class="fw-bold fs-6 text-dark lh-sm">@(Model?.TotalPetsServed > 0 ? $"{Model.TotalPetsServed:N0}+" : "500+")</div>
                            <small class="text-muted" style="font-size: 0.72rem;">Bé cưng được chăm sóc</small>
                        </div>
                    </div>

                    <img src="https://images.unsplash.com/photo-1548767797-d8c844163c4c?w=600&auto=format&fit=crop&q=80" 
                         alt="PawHaven Pets" />

                    <!-- Bubble 2: Đánh giá sao -->
                    <div class="stat-bubble stat-bubble-bottom">
                        <div class="text-start">
                            <div class="text-warning small" style="font-size: 0.85rem; line-height: 1;">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <strong class="text-dark ms-1">5.0</strong>
                            </div>
                            <small class="text-muted" style="font-size: 0.72rem;">từ @(Model?.TotalCustomers > 0 ? Model.TotalCustomers.ToString("N0") : "300+") khách hàng thân thiết</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. THỐNG KÊ ẤN TƯỢNG -->
    <section class="mb-5">
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <div class="kpi-banner-item">
                    <div class="kpi-num">@(Model?.TotalPetsServed > 0 ? $"{Model.TotalPetsServed:N0}+" : "500+")</div>
                    <div class="text-dark fw-bold small mt-1">Lượt chăm sóc bé</div>
                    <small class="text-muted" style="font-size: 0.75rem;">An toàn & khỏe mạnh</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="kpi-banner-item">
                    <div class="kpi-num">99.8%</div>
                    <div class="text-dark fw-bold small mt-1">Hài lòng tuyệt đối</div>
                    <small class="text-muted" style="font-size: 0.75rem;">Phản hồi 5 sao từ chủ nuôi</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="kpi-banner-item">
                    <div class="kpi-num">@(Model?.TotalServices > 0 ? Model.TotalServices.ToString() : "10+")</div>
                    <div class="text-dark fw-bold small mt-1">Dịch vụ chuyên nghiệp</div>
                    <small class="text-muted" style="font-size: 0.75rem;">Đa dạng cho chó & mèo</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="kpi-banner-item">
                    <div class="kpi-num">24/7</div>
                    <div class="text-dark fw-bold small mt-1">Giám sát khách sạn</div>
                    <small class="text-muted" style="font-size: 0.75rem;">Camera trực tiếp mọi lúc</small>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. DANH MỤC DỊCH VỤ NỔI BẬT -->
    <section class="mb-5" id="dich-vu">
        <div class="text-center mb-4">
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fw-bold mb-2">DỊCH VỤ ĐẲNG CẤP</span>
            <h2 class="fw-bold text-dark">Dịch Vụ Chăm Sóc Bé Yêu Toàn Diện</h2>
            <p class="text-muted small">Quy trình chuyên nghiệp với trang thiết bị cao cấp và sữa tắm hữu cơ an toàn cho mọi làn da nhạy cảm.</p>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.FeaturedServices != null && Model.FeaturedServices.Any())
            {
                foreach (var svc in Model.FeaturedServices)
                {
                    string iconName = "bi-stars";
                    string iconStyle = "bg-primary-subtle text-primary";

                    var cat = svc.Category?.ToLower() ?? "";
                    var sName = svc.ServiceName?.ToLower() ?? "";

                    if (cat.Contains("tắm") || sName.Contains("tắm"))
                    {
                        iconName = "bi-droplet-fill";
                        iconStyle = "bg-primary-subtle text-primary";
                    }
                    else if (cat.Contains("cắt") || sName.Contains("cắt") || sName.Contains("tỉa"))
                    {
                        iconName = "bi-scissors";
                        iconStyle = "bg-warning-subtle text-warning-emphasis";
                    }
                    else if (cat.Contains("lưu trú") || cat.Contains("khách sạn") || sName.Contains("khách sạn"))
                    {
                        iconName = "bi-houses-fill";
                        iconStyle = "bg-success-subtle text-success";
                    }
                    else if (cat.Contains("móng") || sName.Contains("móng") || sName.Contains("tai"))
                    {
                        iconName = "bi-clipboard2-pulse-fill";
                        iconStyle = "bg-info-subtle text-info-emphasis";
                    }
                    else if (cat.Contains("y tế") || cat.Contains("khám") || sName.Contains("khám") || sName.Contains("tiêm"))
                    {
                        iconName = "bi-heart-pulse-fill";
                        iconStyle = "bg-danger-subtle text-danger";
                    }
                    else if (cat.Contains("spa") || sName.Contains("spa") || sName.Contains("massage"))
                    {
                        iconName = "bi-flower1";
                        iconStyle = "bg-secondary-subtle text-secondary-emphasis";
                    }

                    <div class="col-md-6 col-lg-4">
                        <div class="home-service-card h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="service-icon-box @iconStyle mb-3">
                                    <i class="bi @iconName"></i>
                                </div>
                                <h5 class="fw-bold text-dark mb-2">@svc.ServiceName</h5>
                                <p class="text-muted small mb-3">@(string.IsNullOrWhiteSpace(svc.Description) ? "Dịch vụ chăm sóc chuyên nghiệp theo tiêu chuẩn 5 sao của PawHaven." : svc.Description)</p>
                                <div class="small text-muted mb-2">
                                    <i class="bi bi-clock me-1"></i>Thời gian: <strong>@(svc.DurationMinutes >= 60 ? $"{svc.DurationMinutes / 60}h{(svc.DurationMinutes % 60 > 0 ? $"{svc.DurationMinutes % 60}p" : "")}" : $"{svc.DurationMinutes} phút")</strong>
                                    @if (!string.IsNullOrEmpty(svc.Category))
                                    {
                                        <span class="ms-2 badge bg-light text-muted border">@svc.Category</span>
                                    }
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-3">
                                <div>
                                    <small class="text-muted d-block" style="font-size: 0.72rem;">Giá niêm yết</small>
                                    <span class="fw-bold text-success fs-5">@svc.BasePrice.ToString("N0") đ</span>
                                </div>
                                <a asp-controller="Appointment" asp-action="Create" asp-route-serviceId="@svc.ServiceId" class="btn btn-sm btn-paw-outline">
                                    <i class="bi bi-calendar-plus me-1"></i>Đặt lịch
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted py-4">
                    Đang cập nhật bảng giá dịch vụ mới nhất từ hệ thống...
                </div>
            }
        </div>
    </section>

    <!-- 4. QUY TRÌNH CHĂM SÓC 4 BƯỚC MINH BẠCH -->
    <section class="mb-5">
        <div class="text-center mb-4">
            <span class="badge bg-light text-secondary border rounded-pill px-3 py-2 fw-bold mb-2">QUY TRÌNH CHUẨN</span>
            <h2 class="fw-bold text-dark">4 Bước Chăm Sóc Chu Đáo Tại PawHaven</h2>
            <p class="text-muted small">Minh bạch từ lúc đặt hẹn cho đến khi đón bé về với nụ cười rạng rỡ.</p>
        </div>

        <div class="row g-3">
            <div class="col-md-6 col-lg-3">
                <div class="step-process-card">
                    <span class="step-badge">01</span>
                    <h6 class="fw-bold text-dark">Đặt lịch trực tuyến</h6>
                    <p class="text-muted small mb-0">Chủ động chọn ngày, khung giờ trống và kỹ thuật viên yêu thích trong 60 giây.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="step-process-card">
                    <span class="step-badge">02</span>
                    <h6 class="fw-bold text-dark">Tiếp nhận & Cân đo</h6>
                    <p class="text-muted small mb-0">Kiểm tra sức khỏe ban đầu, cân nặng thực tế và ghi chú tiền sử dị ứng tại quầy.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="step-process-card">
                    <span class="step-badge">03</span>
                    <h6 class="fw-bold text-dark">Cập nhật ảnh tiến độ</h6>
                    <p class="text-muted small mb-0">Groomer chụp ảnh kết quả Before & Grooming, cập nhật tiến trình trực tiếp cho chủ.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="step-process-card">
                    <span class="step-badge">04</span>
                    <h6 class="fw-bold text-dark">Thanh toán & Đón bé</h6>
                    <p class="text-muted small mb-0">Thanh toán minh bạch qua Tiền mặt hoặc VietQR, áp mã voucher và đón bé về an toàn.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. BANNER KHUYẾN MÃI & MÃ GIẢM GIÁ -->
    <section class="promo-banner mb-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill mb-3">ƯU ĐÃI ĐẶC QUYỀN THÀNH VIÊN</span>
                <h2 class="fw-bold mb-3">Nhận Ngay Voucher Giảm Đến 10% Cho Lần Đặt Đầu Tiên</h2>
                <p class="text-white-50 mb-4" style="font-size: 1.05rem;">
                    Áp dụng mã <strong class="text-white bg-white bg-opacity-25 px-2 py-1 rounded">PAWVIP10</strong> để giảm 10% tổng hóa đơn, hoặc <strong class="text-white bg-white bg-opacity-25 px-2 py-1 rounded">GIAM50K</strong> giảm ngay 50.000đ khi đặt lịch tắm spa combo hôm nay.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Appointment" asp-action="Create" class="btn btn-warning text-dark fw-bold px-4 py-3 rounded-pill shadow">
                        <i class="bi bi-ticket-perforated-fill me-1"></i>Đặt lịch áp voucher ngay
                    </a>
                    <a asp-controller="Account" asp-action="DangKy" class="btn btn-outline-light fw-bold px-4 py-3 rounded-pill">
                        Đăng ký tài khoản mới
                    </a>
                </div>
            </div>
            <div class="col-lg-4 text-center d-none d-lg-block">
                <div class="rounded-4 bg-white bg-opacity-10 p-4 border border-white border-opacity-25 text-center">
                    <i class="bi bi-gift-fill fs-1 text-warning mb-2 d-block"></i>
                    <h4 class="fw-bold text-white mb-1">Mã: PAWVIP10</h4>
                    <p class="text-white-50 small mb-0">Dành riêng cho khách hàng đăng ký trên hệ thống PawHaven.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 6. ĐÁNH GIÁ TỪ CHỦ NUÔI -->
    <section class="mb-5">
        <div class="text-center mb-4">
            <span class="badge bg-light text-secondary border rounded-pill px-3 py-2 fw-bold mb-2">ĐÁNH GIÁ THỰC TẾ</span>
            <h2 class="fw-bold text-dark">Chủ Nuôi Nói Gì Về PawHaven?</h2>
            <p class="text-muted small">Hơn 3.200 đánh giá 5 sao từ cộng đồng yêu chó mèo tại TP. Hồ Chí Minh.</p>
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <div class="testimonial-card">
                    <div class="text-warning mb-2">
                        <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                    </div>
                    <p class="text-secondary small mb-3">
                        "Bé Mochi nhà mình rất nhát người lạ và da nhạy cảm. Các bạn lễ tân và KTV Huy chăm sóc rất nhẹ tay, dùng sữa tắm không Sulfate và gửi ảnh Before/Grooming liên tục nên mình rất yên tâm!"
                    </p>
                    <div class="d-flex align-items-center gap-2 pt-2 border-top">
                        <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&auto=format&fit=crop&q=80" 
                             alt="Customer" class="rounded-circle object-fit-cover" style="width: 36px; height: 36px;">
                        <div>
                            <div class="fw-bold small text-dark lh-sm">Nguyễn Minh Anh</div>
                            <small class="text-muted" style="font-size: 0.72rem;">Chủ bé Mochi (Mèo Anh lông ngắn)</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="testimonial-card">
                    <div class="text-warning mb-2">
                        <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                    </div>
                    <p class="text-secondary small mb-3">
                        "Cắt tỉa kiểu gấu bông cho bé Poodle nhà mình siêu cưng, đường kéo chuẩn chỉnh. Thích nhất là đặt lịch trước trên web tới giờ đến là được vào làm ngay không phải chờ đợi."
                    </p>
                    <div class="d-flex align-items-center gap-2 pt-2 border-top">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&auto=format&fit=crop&q=80" 
                             alt="Customer" class="rounded-circle object-fit-cover" style="width: 36px; height: 36px;">
                        <div>
                            <div class="fw-bold small text-dark lh-sm">Trần Quốc Bảo</div>
                            <small class="text-muted" style="font-size: 0.72rem;">Chủ bé Lucky (Poodle)</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="testimonial-card">
                    <div class="text-warning mb-2">
                        <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                    </div>
                    <p class="text-secondary small mb-3">
                        "Khách sạn thú cưng ở chi nhánh Thảo Điền cực sạch, phòng máy lạnh thơm tho không có mùi. Mình đi công tác 3 ngày mở camera xem bé chơi đùa rất vui."
                    </p>
                    <div class="d-flex align-items-center gap-2 pt-2 border-top">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80" 
                             alt="Customer" class="rounded-circle object-fit-cover" style="width: 36px; height: 36px;">
                        <div>
                            <div class="fw-bold small text-dark lh-sm">Lê Thu Hà</div>
                            <small class="text-muted" style="font-size: 0.72rem;">Chủ bé Bơ (Corgi)</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 7. THÔNG TIN CHI NHÁNH & HOTLINE -->
    <section class="p-4 rounded-4 bg-white border shadow-sm">
        <div class="row align-items-center g-3">
            <div class="col-md-8">
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                        <i class="bi bi-geo-alt-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark mb-1">Hệ thống PawHaven Thảo Điền</h5>
                        <p class="text-muted small mb-1">42 Xuân Thủy, Phường Thảo Điền, TP. Thủ Đức, TP. Hồ Chí Minh</p>
                        <div class="small text-secondary">
                            <i class="bi bi-clock me-1"></i>Mở cửa: <strong>08:00 - 21:00</strong> tất cả các ngày trong tuần (kể cả Lễ, Tết)
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4 text-md-end">
                <div class="d-inline-block p-3 rounded-3 bg-light border text-start">
                    <small class="text-muted d-block" style="font-size: 0.72rem;">Hotline tư vấn & hỗ trợ</small>
                    <a href="tel:19006868" class="fs-4 fw-bold text-success text-decoration-none d-flex align-items-center gap-2">
                        <i class="bi bi-telephone-fill fs-5"></i>
                        <span>1900 6868</span>
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>
