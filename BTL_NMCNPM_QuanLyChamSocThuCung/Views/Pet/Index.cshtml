@model List<BTL_NMCNPM_QuanLyChamSocThuCung.Models.ViewModels.PetListItemViewModel>

@{
    ViewData["Title"] = "Danh sách Thú cưng";
    bool isStaff = ViewBag.IsStaff == true;
    string activeRole = ViewBag.ActiveRole as string ?? "Customer";
}

<div class="row align-items-center mb-4">
    <div class="col-md-6">
        <h2 class="fw-bold mb-1 text-primary">
            <i class="bi bi-heart-pulse-fill text-danger me-2"></i>Quản lý Hồ sơ Thú cưng
        </h2>
        <p class="text-muted mb-0">
            @if (isStaff)
            {
                <span><i class="bi bi-shield-lock-fill text-warning me-1"></i>Chế độ <strong>Nhân viên</strong>: Tra cứu và quản lý toàn bộ thú cưng trong hệ thống</span>
            }
            else
            {
                <span><i class="bi bi-person-heart text-primary me-1"></i>Chế độ <strong>Khách hàng</strong>: Danh sách thú cưng của bạn</span>
            }
        </p>
    </div>
    <div class="col-md-6 text-md-end mt-3 mt-md-0">
        <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
            <i class="bi bi-plus-circle-fill me-1"></i>Thêm thú cưng mới
        </a>
    </div>
</div>

<!-- Thanh tìm kiếm & bộ lọc -->
<div class="card border-0 shadow-sm mb-4 bg-light">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-9 col-lg-10">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="searchTerm" class="form-control border-start-0 ps-0" 
                           placeholder="@(isStaff ? "Tìm kiếm theo Tên thú cưng, Loài, Tên chủ nuôi hoặc Số điện thoại..." : "Tìm theo tên thú cưng hoặc loài...")" 
                           value="@ViewBag.SearchTerm" />
                </div>
            </div>
            <div class="col-md-3 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-dark w-100 rounded-pill">
                    <i class="bi bi-funnel me-1"></i>Tìm kiếm
                </button>
                @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Danh sách thú cưng -->
@if (Model == null || !Model.Any())
{
    <div class="text-center py-5 bg-white rounded shadow-sm border">
        <div class="display-1 text-muted mb-3">🐶🐱</div>
        <h4 class="fw-bold text-secondary">Chưa có hồ sơ thú cưng nào</h4>
        <p class="text-muted">
            @(string.IsNullOrEmpty(ViewBag.SearchTerm as string) 
                ? "Bắt đầu đăng ký thông tin thú cưng đầu tiên để quản lý sức khỏe và lịch tiêm phòng!" 
                : "Không tìm thấy thú cưng nào phù hợp với từ khóa tìm kiếm.")
        </p>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 mt-2">
            <i class="bi bi-plus-lg me-1"></i>Đăng ký thú cưng ngay
        </a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var pet in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 position-relative transition-card">
                    <!-- Alert Badge nếu có lưu ý y tế -->
                    @if (pet.HasMedicalAlert)
                    {
                        <div class="position-absolute top-0 start-0 m-3 z-1">
                            <span class="badge bg-warning text-dark border border-warning shadow-sm" title="Có ghi chú dị ứng hoặc bệnh nền">
                                <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>Lưu ý y tế
                            </span>
                        </div>
                    }

                    <div class="card-body p-4 text-center">
                        <!-- Avatar -->
                        <div class="mb-3 position-relative d-inline-block">
                            @if (!string.IsNullOrEmpty(pet.ImageUrl))
                            {
                                <img src="@pet.ImageUrl" alt="@pet.PetName" 
                                     class="rounded-circle object-fit-cover border border-3 border-primary-subtle shadow" 
                                     style="width: 120px; height: 120px;" 
                                     onerror="this.onerror=null; this.src='https://placehold.co/120x120?text=@pet.PetName';" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center border border-3 border-white shadow mx-auto" 
                                     style="width: 120px; height: 120px; font-size: 2.5rem;">
                                    @(pet.Species.Contains("Mèo", StringComparison.OrdinalIgnoreCase) ? "🐱" : "🐶")
                                </div>
                            }
                            <span class="position-absolute bottom-0 end-0 badge rounded-pill @(pet.Gender == "Đực" ? "bg-info" : "bg-danger") shadow">
                                @(pet.Gender == "Đực" ? "♂ Đực" : "♀ Cái")
                            </span>
                        </div>

                        <!-- Tên & Giống loài -->
                        <h4 class="card-title fw-bold mb-1">@pet.PetName</h4>
                        <p class="text-muted small mb-2">
                            <span class="badge bg-light text-dark border">@pet.Species</span>
                            @if (!string.IsNullOrEmpty(pet.Breed))
                            {
                                <span class="badge bg-light text-secondary border">@pet.Breed</span>
                            }
                        </p>

                        <!-- Thông số sinh học -->
                        <div class="row g-2 text-start bg-light rounded-3 p-2 my-2 small">
                            <div class="col-6">
                                <span class="text-muted"><i class="bi bi-calendar3 me-1"></i>Tuổi:</span>
                                <strong class="d-block text-dark">@pet.AgeDisplay</strong>
                            </div>
                            <div class="col-6">
                                <span class="text-muted"><i class="bi bi-speedometer2 me-1"></i>Cân nặng:</span>
                                <strong class="d-block text-dark">@pet.Weight.ToString("F2") kg</strong>
                            </div>
                            @if (isStaff)
                            {
                                <div class="col-12 border-top pt-1 mt-1">
                                    <span class="text-muted"><i class="bi bi-person me-1"></i>Chủ nuôi:</span>
                                    <strong class="text-dark">@pet.OwnerName</strong> 
                                    <span class="text-muted">(@pet.OwnerPhone)</span>
                                </div>
                            }
                        </div>

                        <!-- Trạng thái tiêm chủng tóm tắt -->
                        <div class="mt-2 text-start small">
                            <span class="text-muted"><i class="bi bi-shield-check text-success me-1"></i>Tiêm chủng:</span>
                            @if (pet.NextDueVaccineDate.HasValue)
                            {
                                var today = DateOnly.FromDateTime(DateTime.Today);
                                if (pet.NextDueVaccineDate.Value < today)
                                {
                                    <span class="badge bg-danger">Quá hạn hẹn nhắc lại</span>
                                }
                                else if (pet.NextDueVaccineDate.Value <= today.AddDays(14))
                                {
                                    <span class="badge bg-warning text-dark">Sắp đến hạn nhắc lại</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success">Đã đủ mũi hẹn</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Đã ghi nhận @pet.TotalVaccinations mũi</span>
                            }
                        </div>
                    </div>

                    <!-- Footer Thao tác -->
                    <div class="card-footer bg-white border-top-0 pt-0 pb-3 px-4 d-flex justify-content-between align-items-center">
                        <a asp-action="Details" asp-route-id="@pet.PetId" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                            <i class="bi bi-eye-fill me-1"></i>Hồ sơ
                        </a>
                        <div class="btn-group">
                            <a asp-action="Edit" asp-route-id="@pet.PetId" class="btn btn-sm btn-outline-secondary rounded-start-pill" title="Chỉnh sửa">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-end-pill" 
                                    data-bs-toggle="modal" data-bs-target="#deletePetModal" 
                                    data-petid="@pet.PetId" data-petname="@pet.PetName" title="Xóa">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Modal Xác nhận xóa thú cưng -->
<div class="modal fade" id="deletePetModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận Xóa Hồ sơ Thú cưng
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="deletePetForm" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deletePetIdInput" />
                <div class="modal-body p-4">
                    <p class="mb-2">Bạn có chắc chắn muốn xóa thú cưng <strong id="deletePetNameDisplay" class="text-danger"></strong> không?</p>
                    <div class="alert alert-warning small mb-0">
                        <i class="bi bi-shield-exclamation me-1"></i>
                        <strong>Lưu ý bảo toàn dữ liệu:</strong> Nếu thú cưng đã có lịch hẹn hoặc lịch sử dịch vụ trong hệ thống, hệ thống sẽ từ chối xóa để đảm bảo toàn vẹn dữ liệu.
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger px-4">Xác nhận Xóa</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deletePetModal = document.getElementById('deletePetModal');
        if (deletePetModal) {
            deletePetModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const petId = button.getAttribute('data-petid');
                const petName = button.getAttribute('data-petname');
                document.getElementById('deletePetIdInput').value = petId;
                document.getElementById('deletePetNameDisplay').textContent = petName;
            });
        }
    </script>
}
