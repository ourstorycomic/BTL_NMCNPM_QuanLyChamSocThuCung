@model List<BTL_NMCNPM_QuanLyChamSocThuCung.Models.ViewModels.PetListItemViewModel>

@{
    ViewData["Title"] = "Hồ sơ Thú cưng";
    bool isStaff = ViewBag.IsStaff == true;
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<!-- Header Quản lý Hồ sơ Thú cưng -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="rounded-3 bg-success bg-opacity-10 text-success p-2 d-inline-flex align-items-center justify-content-center shadow-xs" style="width: 42px; height: 42px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                    <ellipse cx="12" cy="16.5" rx="5" ry="4"/>
                    <circle cx="6" cy="10" r="2.2"/>
                    <circle cx="10" cy="6.8" r="2.2"/>
                    <circle cx="14" cy="6.8" r="2.2"/>
                    <circle cx="18" cy="10" r="2.2"/>
                </svg>
            </span>
            <h2 class="fw-bold mb-0 text-dark" style="letter-spacing: -0.02em;">Quản lý Hồ sơ Thú cưng</h2>
            <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle fw-semibold px-2.5 py-1" style="font-size: 0.78rem;">
                @(Model?.Count ?? 0) bé cưng
            </span>
        </div>
        <p class="text-muted mb-0 small ms-1">
            @if (isStaff)
            {
                <span>Theo dõi thể trạng, tiền sử dị ứng (FR-09) và quản lý sổ tiêm chủng của tất cả thú cưng trong hệ thống.</span>
            }
            else
            {
                <span>Danh sách các bé cưng của bạn. Đăng ký hồ sơ để nhận nhắc lịch tiêm phòng và đặt lịch chăm sóc chu đáo!</span>
            }
        </p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-paw-primary shadow-sm">
            <i class="bi bi-plus-lg me-1 fs-6"></i>Thêm thú cưng mới
        </a>
    </div>
</div>

<!-- Thanh tìm kiếm & Bộ lọc nhanh PawHaven -->
<div class="paw-card p-3 mb-4 bg-white">
    <form method="get" asp-action="Index" id="petSearchForm">
        <div class="row g-2 align-items-center">
            <div class="col-lg-9 col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted ps-3">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchTerm" id="searchInput" class="form-control bg-light border-start-0 ps-2" 
                           placeholder="@(isStaff ? "Tìm kiếm theo tên bé, loài, chủ nuôi hoặc số điện thoại..." : "Tìm kiếm theo tên bé cưng, loài...")" 
                           value="@ViewBag.SearchTerm" style="font-size: 0.9rem;" />
                    @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
                    {
                        <a asp-action="Index" class="btn btn-light border border-start-0 text-muted" title="Xóa tìm kiếm">
                            <i class="bi bi-x-circle-fill"></i>
                        </a>
                    }
                </div>
            </div>
            <div class="col-lg-3 col-md-4">
                <button type="submit" class="btn btn-paw-primary w-100">
                    <i class="bi bi-funnel me-1"></i>Tìm kiếm
                </button>
            </div>
        </div>

        <!-- Quick Filter Tags -->
        <div class="d-flex align-items-center gap-2 mt-3 pt-2 border-top flex-wrap" style="font-size: 0.82rem;">
            <span class="text-muted fw-semibold me-1"><i class="bi bi-filter-circle me-1"></i>Lọc nhanh:</span>
            <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 py-1 fw-medium filter-chip active" data-filter="all">Tất cả (@(Model?.Count ?? 0))</button>
            <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 py-1 fw-medium filter-chip" data-filter="dog"><i class="bi bi-heart me-1 text-primary"></i>Chó</button>
            <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 py-1 fw-medium filter-chip" data-filter="cat"><i class="bi bi-heart me-1 text-success"></i>Mèo</button>
            <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 py-1 fw-medium filter-chip" data-filter="allergy"><i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i>Có dị ứng</button>
            <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 py-1 fw-medium filter-chip" data-filter="overdue"><i class="bi bi-calendar-x me-1 text-danger"></i>Quá hạn tiêm</button>
        </div>
    </form>
</div>

<!-- Danh sách thú cưng -->
@if (Model == null || !Model.Any())
{
    <div class="text-center py-5 bg-white rounded-4 shadow-sm border p-4">
        <div class="display-3 text-muted mb-3 opacity-50"><i class="bi bi-folder2-open"></i></div>
        <h5 class="fw-bold text-dark">Chưa có hồ sơ thú cưng nào</h5>
        <p class="text-muted small mb-4">
            @(string.IsNullOrEmpty(ViewBag.SearchTerm as string) 
                ? "Bắt đầu đăng ký hồ sơ bé cưng đầu tiên để quản lý sức khỏe và lịch tiêm phòng chu đáo." 
                : "Không tìm thấy thú cưng nào phù hợp với từ khóa tìm kiếm của bạn.")
        </p>
        <a asp-action="Create" class="btn btn-paw-primary">
            <i class="bi bi-plus-lg me-1"></i>Đăng ký thú cưng ngay
        </a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4" id="petCardGrid">
        @foreach (var pet in Model)
        {
            bool isDog = pet.Species.Contains("Chó", StringComparison.OrdinalIgnoreCase);
            bool isCat = pet.Species.Contains("Mèo", StringComparison.OrdinalIgnoreCase);
            bool isOverdue = pet.NextDueVaccineDate.HasValue && pet.NextDueVaccineDate.Value < today;
            bool hasAllergy = !string.IsNullOrWhiteSpace(pet.AllergyNote) || pet.HasMedicalAlert;

            <div class="col pet-card-item" 
                 data-species="@(isDog ? "dog" : (isCat ? "cat" : "other"))"
                 data-allergy="@(hasAllergy ? "true" : "false")"
                 data-overdue="@(isOverdue ? "true" : "false")">
                <div class="paw-card h-100 p-4 d-flex flex-column justify-content-between position-relative">
                    <div>
                        <!-- Top Header: Avatar + Tên + Giới tính -->
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <!-- Avatar bo góc 18px theo chuẩn Figma -->
                            <div class="position-relative flex-shrink-0">
                                @if (!string.IsNullOrEmpty(pet.ImageUrl))
                                {
                                    <img src="@pet.ImageUrl" alt="@pet.PetName" 
                                         class="pet-avatar-box object-fit-cover border" 
                                         style="width: 84px; height: 84px; border-radius: 18px;" 
                                         onerror="this.onerror=null; this.src='https://placehold.co/84x84?text=@pet.PetName';" />
                                }
                                else
                                {
                                    <div class="pet-avatar-box d-flex flex-column align-items-center justify-content-center border" 
                                         style="width: 84px; height: 84px; border-radius: 18px; background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);">
                                        <i class="bi bi-paw-fill text-success" style="font-size: 2rem;"></i>
                                    </div>
                                }
                                <span class="position-absolute bottom-0 end-0 badge rounded-pill shadow-xs" 
                                      style="font-size: 0.68rem; transform: translate(10%, 15%); font-weight: 700; @(pet.Gender == "Đực" ? "background: #eff6ff; color: #2563eb; border: 1.5px solid #bfdbfe;" : "background: #fff1f2; color: #e11d48; border: 1.5px solid #fecdd3;")">
                                    @(pet.Gender == "Đực" ? "♂ Đực" : "♀ Cái")
                                </span>
                            </div>

                            <!-- Tên & Phân loại -->
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <h5 class="fw-bold mb-0 text-dark text-truncate" title="@pet.PetName" style="font-size: 1.18rem;">
                                        @pet.PetName
                                    </h5>
                                    @if (hasAllergy)
                                    {
                                        <span class="badge bg-warning bg-opacity-25 text-warning-emphasis border border-warning" style="font-size: 0.68rem; font-weight: 700;" title="Có lưu ý dị ứng hoặc bệnh nền">
                                            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>Dị ứng
                                        </span>
                                    }
                                </div>
                                <div class="text-muted small mb-2 text-truncate">
                                    <span class="fw-semibold text-secondary">@pet.Species</span>
                                    @if (!string.IsNullOrEmpty(pet.Breed))
                                    {
                                        <span> · @pet.Breed</span>
                                    }
                                </div>
                                
                                <!-- Meta Chips: Tuổi và Cân nặng -->
                                <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                    <span class="paw-meta-chip">
                                        <i class="bi bi-cake2 text-warning"></i>@pet.AgeDisplay
                                    </span>
                                    <span class="paw-meta-chip">
                                        <i class="bi bi-speedometer2 text-info"></i>@pet.Weight.ToString("F1") kg
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Cảnh báo dị ứng nổi bật theo chuẩn ảnh Figma (FR-09) -->
                        @if (!string.IsNullOrWhiteSpace(pet.AllergyNote))
                        {
                            <div class="paw-health-alert small mb-3">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="fw-bold text-warning-emphasis d-flex align-items-center" style="font-size: 0.8rem;">
                                        <i class="bi bi-exclamation-triangle-fill text-warning me-1.5"></i>Lưu ý dị ứng:
                                    </span>
                                    <span class="badge bg-warning bg-opacity-25 text-warning-emphasis border border-warning" style="font-size: 0.62rem;">FR-09</span>
                                </div>
                                <div class="text-dark lh-sm" style="font-size: 0.84rem;">@pet.AllergyNote</div>
                            </div>
                        }

                        <!-- Ghi chú y tế & tính cách nếu có -->
                        @if (!string.IsNullOrWhiteSpace(pet.MedicalHistory))
                        {
                            <div class="p-2 px-2.5 rounded-3 bg-light border text-muted small mb-3" style="font-size: 0.8rem;">
                                <span class="fw-semibold text-dark"><i class="bi bi-journal-medical text-primary me-1"></i>Bệnh nền:</span> @pet.MedicalHistory
                            </div>
                        }

                        <!-- Chủ nuôi (Hiển thị nếu là Staff) -->
                        @if (isStaff)
                        {
                            <div class="p-2 px-3 rounded-3 bg-light border small mb-3 d-flex justify-content-between align-items-center">
                                <span class="text-muted">Chủ nuôi: <strong class="text-dark">@pet.OwnerName</strong></span>
                                <a href="tel:@pet.OwnerPhone" class="text-success text-decoration-none fw-semibold">
                                    <i class="bi bi-telephone-fill me-1"></i>@pet.OwnerPhone
                                </a>
                            </div>
                        }

                        <!-- Lịch tiêm phòng -->
                        <div class="d-flex align-items-center justify-content-between small pt-2.5 border-top">
                            <span class="text-muted fw-semibold" style="font-size: 0.82rem;">
                                <i class="bi bi-shield-plus text-success me-1"></i>Tiêm chủng:
                            </span>
                            @if (pet.NextDueVaccineDate.HasValue)
                            {
                                if (isOverdue)
                                {
                                    <span class="vaccine-status-pill overdue">
                                        <span class="p-1 rounded-circle bg-danger d-inline-block"></span>Quá hạn nhắc: @pet.NextDueVaccineDate.Value.ToString("dd/MM/yyyy")
                                    </span>
                                }
                                else if (pet.NextDueVaccineDate.Value <= today.AddDays(14))
                                {
                                    <span class="vaccine-status-pill warning">
                                        <span class="p-1 rounded-circle bg-warning d-inline-block"></span>Hẹn nhắc: @pet.NextDueVaccineDate.Value.ToString("dd/MM")
                                    </span>
                                }
                                else
                                {
                                    <span class="vaccine-status-pill good">
                                        <span class="p-1 rounded-circle bg-success d-inline-block"></span>Hẹn nhắc: @pet.NextDueVaccineDate.Value.ToString("dd/MM/yyyy")
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-light text-secondary border">Đã ghi @pet.TotalVaccinations mũi</span>
                            }
                        </div>
                    </div>

                    <!-- Footer Thao tác: Nút Xem chi tiết làm Primary CTA -->
                    <div class="d-flex align-items-center justify-content-between mt-3 pt-3 border-top gap-2">
                        <a asp-action="Details" asp-route-id="@pet.PetId" class="btn btn-sm btn-paw-primary flex-grow-1">
                            <i class="bi bi-eye me-1.5"></i>Xem chi tiết hồ sơ
                        </a>
                        <div class="d-flex gap-1.5">
                            <a asp-action="Edit" asp-route-id="@pet.PetId" class="btn btn-sm btn-light border rounded-circle text-muted" title="Chỉnh sửa hồ sơ" style="width: 36px; height: 36px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-light border rounded-circle text-danger" 
                                    data-bs-toggle="modal" data-bs-target="#deletePetModal" 
                                    data-petid="@pet.PetId" data-petname="@pet.PetName" title="Xóa thú cưng" 
                                    style="width: 36px; height: 36px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Modal Xác nhận xóa thú cưng -->
<div class="modal fade" id="deletePetModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa hồ sơ thú cưng
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="deletePetForm" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deletePetIdInput" />
                <div class="modal-body p-4">
                    <p class="mb-3">Bạn có chắc chắn muốn xóa hồ sơ thú cưng <strong id="deletePetNameDisplay" class="text-danger"></strong> không?</p>
                    <div class="alert alert-warning small mb-0 rounded-3 border-0 bg-warning bg-opacity-10 text-dark">
                        <i class="bi bi-shield-exclamation me-1 text-warning"></i>
                        <strong>Chính sách bảo toàn dữ liệu:</strong> Nếu thú cưng đã từng có lịch hẹn hoặc lịch sử dịch vụ, hệ thống sẽ từ chối xóa để đảm bảo lịch sử thanh toán không bị gián đoạn.
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-paw-outline" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Xác nhận xóa</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Modal xóa
        const deletePetModal = document.getElementById('deletePetModal');
        if (deletePetModal) {
            deletePetModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const petId = button.getAttribute('data-petid');
                const petName = button.getAttribute('data-petname');
                document.getElementById('deletePetIdInput').value = petId;
                document.getElementById('deletePetNameDisplay').textContent = petName;
            });
        }

        // Lọc nhanh bằng tag chip
        const filterChips = document.querySelectorAll('.filter-chip');
        const petCards = document.querySelectorAll('.pet-card-item');

        filterChips.forEach(chip => {
            chip.addEventListener('click', function () {
                filterChips.forEach(c => {
                    c.classList.remove('active', 'btn-paw-primary', 'text-white');
                    c.classList.add('btn-light', 'text-dark');
                });
                this.classList.add('active', 'btn-paw-primary', 'text-white');
                this.classList.remove('btn-light', 'text-dark');

                const filter = this.getAttribute('data-filter');

                petCards.forEach(card => {
                    if (filter === 'all') {
                        card.style.display = '';
                    } else if (filter === 'dog') {
                        card.style.display = card.getAttribute('data-species') === 'dog' ? '' : 'none';
                    } else if (filter === 'cat') {
                        card.style.display = card.getAttribute('data-species') === 'cat' ? '' : 'none';
                    } else if (filter === 'allergy') {
                        card.style.display = card.getAttribute('data-allergy') === 'true' ? '' : 'none';
                    } else if (filter === 'overdue') {
                        card.style.display = card.getAttribute('data-overdue') === 'true' ? '' : 'none';
                    }
                });
            });
        });
    </script>
}
