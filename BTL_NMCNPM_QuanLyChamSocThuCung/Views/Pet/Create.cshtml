@model BTL_NMCNPM_QuanLyChamSocThuCung.Models.ViewModels.PetCreateViewModel

@{
    ViewData["Title"] = "Thêm Thú cưng mới";
    bool isStaff = ViewBag.IsStaff == true;
    var customerOptions = ViewBag.CustomerOptions as List<BTL_NMCNPM_QuanLyChamSocThuCung.Models.ViewModels.CustomerOptionViewModel>;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a asp-action="Index">Thú cưng</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Đăng ký mới</li>
                    </ol>
                </nav>
                <h2 class="fw-bold text-primary mb-0">
                    <i class="bi bi-plus-circle-fill text-primary me-2"></i>Đăng ký Hồ sơ Thú cưng mới
                </h2>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                <i class="bi bi-arrow-left me-1"></i>Hủy & Quay lại
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 shadow-sm" role="alert"></div>

                    @if (isStaff && customerOptions != null && customerOptions.Any())
                    {
                        <div class="p-3 bg-light rounded-3 border mb-4">
                            <label asp-for="CustomerId" class="form-label fw-bold text-dark">
                                <i class="bi bi-person-check-fill text-warning me-1"></i>Chọn Chủ nuôi (Khách hàng) <span class="text-danger">*</span>
                            </label>
                            <select asp-for="CustomerId" class="form-select select2" required>
                                <option value="">-- Chọn khách hàng sở hữu thú cưng --</option>
                                @foreach (var c in customerOptions)
                                {
                                    <option value="@c.CustomerId">@c.DisplayText</option>
                                }
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>
                    }

                    <!-- 1. THÔNG TIN ĐỊNH DANH & ẢNH ĐẠI DIỆN -->
                    <h5 class="fw-bold text-secondary border-bottom pb-2 mb-4">
                        <i class="bi bi-info-circle-fill text-primary me-2"></i>1. Thông tin Nhận diện & Ngoại hình
                    </h5>

                    <div class="row g-4 mb-4">
                        <!-- Preview ảnh -->
                        <div class="col-md-4 text-center">
                            <label class="form-label fw-bold d-block">Ảnh đại diện thú cưng</label>
                            <div class="position-relative d-inline-block mb-3">
                                <img id="avatarPreview" src="https://placehold.co/150x150?text=Preview" 
                                     alt="Preview" class="rounded-circle object-fit-cover border border-4 border-primary-subtle shadow" 
                                     style="width: 140px; height: 140px;" />
                            </div>
                            <div class="text-muted small">Hỗ trợ file ảnh (JPG, PNG, WEBP) hoặc nhập đường dẫn URL</div>
                        </div>

                        <div class="col-md-8">
                            <!-- Chọn ảnh máy tính -->
                            <div class="mb-3">
                                <label asp-for="ImageFile" class="form-label fw-semibold">
                                    <i class="bi bi-upload me-1"></i>Tải ảnh từ máy tính:
                                </label>
                                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" id="imageFileInput" />
                                <span asp-validation-for="ImageFile" class="text-danger small"></span>
                            </div>

                            <!-- Hoặc nhập link URL -->
                            <div class="mb-3">
                                <label asp-for="ImageUrl" class="form-label fw-semibold">
                                    <i class="bi bi-link-45deg me-1"></i>Hoặc nhập đường dẫn ảnh (URL):
                                </label>
                                <input asp-for="ImageUrl" class="form-control" id="imageUrlInput" placeholder="https://example.com/pet-image.jpg" />
                                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="PetName" class="form-label fw-bold">
                                Tên thú cưng <span class="text-danger">*</span>
                            </label>
                            <input asp-for="PetName" class="form-control" placeholder="VD: Miu Miu, Corgi Bông..." required />
                            <span asp-validation-for="PetName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Species" class="form-label fw-bold">
                                Loài <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Species" class="form-select" required>
                                <option value="">-- Chọn loài --</option>
                                <option value="Chó">Chó</option>
                                <option value="Mèo">Mèo</option>
                                <option value="Thỏ">Thỏ</option>
                                <option value="Hamster">Hamster</option>
                                <option value="Chim cảnh">Chim cảnh</option>
                                <option value="Khác">Khác</option>
                            </select>
                            <span asp-validation-for="Species" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Breed" class="form-label fw-bold">Giống loài chi tiết</label>
                            <input asp-for="Breed" class="form-control" placeholder="VD: Poodle, Golden, Anh lông ngắn..." />
                            <span asp-validation-for="Breed" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold d-block">Giới tính <span class="text-danger">*</span></label>
                            <div class="d-flex gap-4 pt-1">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="Đực" id="genderMale" checked>
                                    <label class="form-check-label" for="genderMale">
                                        <i class="bi bi-gender-male text-info me-1"></i>Đực
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="Cái" id="genderFemale">
                                    <label class="form-check-label" for="genderFemale">
                                        <i class="bi bi-gender-female text-danger me-1"></i>Cái
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="BirthDate" class="form-label fw-bold">Ngày sinh (ước lượng)</label>
                            <input asp-for="BirthDate" type="date" class="form-control" />
                            <span asp-validation-for="BirthDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Weight" class="form-label fw-bold">
                                Cân nặng (kg) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="Weight" type="number" step="0.01" min="0.01" class="form-control" placeholder="VD: 3.5" required />
                                <span class="input-group-text">kg</span>
                            </div>
                            <span asp-validation-for="Weight" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- 2. HỒ SƠ Y TẾ & LƯU Ý SỨC KHỎE (FR-09) -->
                    <h5 class="fw-bold text-secondary border-bottom pb-2 mb-4 pt-3">
                        <i class="bi bi-heart-pulse-fill text-danger me-2"></i>2. Hồ sơ Y tế & Cảnh báo Sức khỏe (FR-09)
                    </h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="AllergyNote" class="form-label fw-bold text-danger">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Ghi chú Dị ứng (nếu có)
                            </label>
                            <textarea asp-for="AllergyNote" class="form-control border-danger-subtle" rows="3" 
                                      placeholder="VD: Dị ứng sữa tươi, dị ứng thuốc gây mê, dị ứng xà phòng hương liệu..."></textarea>
                            <span asp-validation-for="AllergyNote" class="text-danger small"></span>
                            <div class="form-text text-danger">Thông tin này sẽ được cảnh báo nổi bật khi tiếp nhận tại quầy và khi làm dịch vụ!</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MedicalHistory" class="form-label fw-bold text-warning-emphasis">
                                <i class="bi bi-journal-medical me-1"></i>Tiền sử Bệnh nền & Đặc điểm tính cách
                            </label>
                            <textarea asp-for="MedicalHistory" class="form-control" rows="3" 
                                      placeholder="VD: Từng phẫu thuật gãy xương, tim mạch nhạy cảm, nhát người lạ, sợ máy sấy..."></textarea>
                            <span asp-validation-for="MedicalHistory" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-4">
                        <a asp-action="Index" class="btn btn-light px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-5 shadow-sm rounded-pill">
                            <i class="bi bi-check-lg me-1"></i>Hoàn tất Đăng ký
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Live image preview
        const fileInput = document.getElementById('imageFileInput');
        const urlInput = document.getElementById('imageUrlInput');
        const preview = document.getElementById('avatarPreview');

        if (fileInput) {
            fileInput.addEventListener('change', function(e) {
                if (e.target.files && e.target.files[0]) {
                    const reader = new FileReader();
                    reader.onload = function(ev) {
                        preview.src = ev.target.result;
                    };
                    reader.readAsDataURL(e.target.files[0]);
                }
            });
        }

        if (urlInput) {
            urlInput.addEventListener('input', function(e) {
                if (e.target.value.trim() !== '') {
                    preview.src = e.target.value.trim();
                }
            });
        }
    </script>
}
