@model BTL_NMCNPM_QuanLyChamSocThuCung.Models.ViewModels.VaccinationCreateViewModel

@{
    var todayStr = DateTime.Today.ToString("yyyy-MM-dd");
    var tomorrowStr = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
}

<div class="modal fade" id="addVaccineModal" tabindex="-1" aria-labelledby="addVaccineModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0" style="border-radius: 18px;">
            <div class="modal-header border-bottom pb-3">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center" id="addVaccineModalLabel">
                    <span class="rounded-3 bg-success bg-opacity-10 text-success p-2 d-inline-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                        <i class="bi bi-shield-plus"></i>
                    </span>
                    Thêm Mũi Tiêm Chủng Mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddVaccination" method="post" id="vaccineForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="PetId" />

                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label asp-for="VaccineName" class="form-label fw-bold text-dark small">
                            Tên loại Vắc-xin <span class="text-danger">*</span>
                        </label>
                        <input asp-for="VaccineName" class="form-control rounded-3" 
                               placeholder="VD: Vắc-xin 4 bệnh cho Mèo (Felocell), Vắc-xin Dại..." required />
                        <span asp-validation-for="VaccineName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="VaccinationDate" class="form-label fw-bold text-dark small">
                                Ngày tiêm chủng <span class="text-danger">*</span>
                            </label>
                            <input asp-for="VaccinationDate" type="date" class="form-control rounded-3" 
                                   max="@todayStr" id="vacDateInput" required />
                            <div class="text-muted" style="font-size: 0.72rem;">* Tiêm rồi mới ghi sổ (ngày quá khứ hoặc hôm nay)</div>
                            <span asp-validation-for="VaccinationDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NextDueDate" class="form-label fw-bold text-dark small">
                                Ngày hẹn tiêm nhắc lại
                            </label>
                            <input asp-for="NextDueDate" type="date" class="form-control rounded-3" 
                                   min="@tomorrowStr" id="nextDueDateInput" />
                            <div class="text-muted" style="font-size: 0.72rem;">* Phải ở tương lai và lớn hơn ngày tiêm</div>
                            <span asp-validation-for="NextDueDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Note" class="form-label fw-bold text-dark small">Ghi chú chuyên môn (nếu có)</label>
                        <textarea asp-for="Note" class="form-control rounded-3" rows="2" 
                                  placeholder="Liều lượng, phản ứng sau tiêm, số lô vắc-xin..."></textarea>
                        <span asp-validation-for="Note" class="text-danger small"></span>
                    </div>

                    <div class="alert alert-light border small text-muted mb-0 rounded-3">
                        <i class="bi bi-info-circle text-success me-1"></i>
                        Tuân thủ chuẩn hóa <strong>1NF</strong>: Mỗi mũi tiêm được ghi nhận thành một bản ghi riêng trong bảng <code>Vaccination</code> để dễ dàng xuất sổ tiêm phòng và cảnh báo lịch hẹn.
                    </div>
                </div>

                <div class="modal-footer border-top bg-light" style="border-radius: 0 0 18px 18px;">
                    <button type="button" class="btn btn-paw-outline" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-paw-primary px-4 shadow">
                        <i class="bi bi-check-lg me-1"></i>Lưu Mũi Tiêm
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const vacDate = document.getElementById('vacDateInput');
    const nextDate = document.getElementById('nextDueDateInput');
    if (vacDate && nextDate) {
        vacDate.addEventListener('change', function () {
            if (vacDate.value) {
                // Next due date must be greater than vaccination date
                const minNext = new Date(vacDate.value);
                minNext.setDate(minNext.getDate() + 1);
                const minStr = minNext.toISOString().split('T')[0];
                nextDate.min = minStr;
                if (nextDate.value && nextDate.value <= vacDate.value) {
                    nextDate.value = minStr;
                }
            }
        });
    }
</script>
