@model BTL_NMCNPM_QuanLyChamSocThuCung.Models.Customer
@{
    ViewData["Title"] = "Thêm Khách Hàng";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header border-0 py-4" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                    <h4 class="mb-0 fw-bold text-white text-center"><i class="bi bi-person-plus-fill me-2"></i>Thêm Khách Hàng Mới</h4>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Create">
                        <div class="mb-4">
                            <label asp-for="CustomerName" class="form-label fw-bold text-muted small">TÊN KHÁCH HÀNG <span class="text-danger">*</span></label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-person text-secondary"></i></span>
                                <input asp-for="CustomerName" class="form-control border-0 bg-light" required placeholder="VD: Nguyễn Văn A" />
                            </div>
                        </div>
                        
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-bold text-muted small">SỐ ĐIỆN THOẠI <span class="text-danger">*</span></label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-0"><i class="bi bi-telephone text-secondary"></i></span>
                                    <input asp-for="PhoneNumber" class="form-control border-0 bg-light" required placeholder="0987..." />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold text-muted small">EMAIL</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-0"><i class="bi bi-envelope text-secondary"></i></span>
                                    <input asp-for="Email" type="email" class="form-control border-0 bg-light" placeholder="email@gmail.com" />
                                </div>
                            </div>
                        </div>
                        
                        <div class="mb-5">
                            <label asp-for="Address" class="form-label fw-bold text-muted small">ĐỊA CHỈ</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-geo-alt text-secondary"></i></span>
                                <textarea asp-for="Address" class="form-control border-0 bg-light" rows="2" placeholder="Nhập địa chỉ..."></textarea>
                            </div>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-light btn-lg px-4 rounded-pill text-muted"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
                            <button type="submit" class="btn btn-gradient-success btn-lg px-5 rounded-pill shadow"><i class="bi bi-save me-1"></i> Lưu Lại</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>