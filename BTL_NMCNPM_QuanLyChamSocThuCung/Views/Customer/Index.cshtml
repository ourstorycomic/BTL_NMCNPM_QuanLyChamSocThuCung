@model IEnumerable<BTL_NMCNPM_QuanLyChamSocThuCung.Models.Customer>
@{
    ViewData["Title"] = "Quản lý Khách Hàng";
}

<div class="container mt-4">
    <!-- Tiêu đề & Nút thêm -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary fw-bold mb-0"><i class="bi bi-people-fill me-2"></i>Quản lý Khách Hàng</h2>
            <p class="text-muted small mb-0">Danh sách chủ nuôi và thông tin liên hệ</p>
        </div>
        <a asp-action="Create" class="btn btn-success shadow-sm"><i class="bi bi-person-plus-fill me-1"></i> Thêm Khách Hàng</a>
    </div>

    <!-- Thông báo -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Thẻ thống kê nhanh -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow-sm border-0">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-person-lines-fill fs-1 me-3 opacity-50"></i>
                    <div>
                        <h6 class="mb-0 opacity-75">Tổng Khách Hàng</h6>
                        <h3 class="mb-0 fw-bold">@Model.Count()</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Thanh tìm kiếm -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-center">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchString" class="form-control border-start-0 bg-light" placeholder="Tìm kiếm theo tên hoặc số điện thoại..." value="@ViewData["CurrentFilter"]" />
                    </div>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary me-2"><i class="bi bi-funnel"></i> Lọc</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i> Làm mới</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng dữ liệu -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Khách Hàng</th>
                            <th>Số Điện Thoại</th>
                            <th>Email</th>
                            <th>Ngày Tham Gia</th>
                            <th class="text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-5"><i class="bi bi-inbox fs-3 d-block mb-2"></i>Không có dữ liệu khách hàng.</td></tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <!-- Tạo Avatar bằng chữ cái đầu -->
                                        <div class="rounded-circle bg-info text-white d-flex justify-content-center align-items-center me-3 fw-bold" style="width: 40px; height: 40px; font-size: 1.2rem;">
                                            @item.CustomerName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold">@item.CustomerName</h6>
                                            <small class="text-muted">ID: @item.Id.ToString().Substring(0, 8)...</small>
                                        </div>
                                    </div>
                                </td>
                                <td><i class="bi bi-telephone text-muted me-1"></i> @item.PhoneNumber</td>
                                <td>@(string.IsNullOrEmpty(item.Email) ? "<span class='text-muted fst-italic'>Chưa cập nhật</span>" : item.Email)</td>
                                <td><i class="bi bi-calendar-event text-muted me-1"></i> @item.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="text-center pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Sửa"><i class="bi bi-pencil-square"></i></a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn ngừng hoạt động khách hàng này?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>