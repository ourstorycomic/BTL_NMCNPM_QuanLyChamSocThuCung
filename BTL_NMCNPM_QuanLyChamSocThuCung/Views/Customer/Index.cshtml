@model IEnumerable<BTL_NMCNPM_QuanLyChamSocThuCung.Models.Customer>
@{
    ViewData["Title"] = "Quản lý Khách Hàng";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-paw fw-bold mb-1">
                <i class="bi bi-people-fill me-2"></i>Quản lý Khách Hàng
            </h2>
            <p class="text-muted small mb-0">Hệ thống quản lý thông tin chủ nuôi và thú cưng</p>
        </div>
        <a asp-action="Create" class="btn btn-paw rounded-pill px-4 shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Thêm Khách Hàng
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 hover-lift text-white" style="background-color: #10b981;">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="bg-white bg-opacity-25 rounded-circle p-3 me-3">
                        <i class="bi bi-person-lines-fill fs-3"></i>
                    </div>
                    <div>
                        <h6 class="mb-1 text-white text-opacity-75 fw-normal">Tổng Số Khách Hàng</h6>
                        <h2 class="mb-0 fw-bold">@Model.Count()</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-9">
                    <div class="input-group bg-light rounded-pill overflow-hidden px-3 py-1 border">
                        <span class="input-group-text bg-transparent border-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchString" class="form-control border-0 bg-transparent shadow-none" placeholder="Nhập tên hoặc số điện thoại để tìm kiếm..." value="@ViewData["CurrentFilter"]" />
                    </div>
                </div>
                <div class="col-md-3 text-end">
                    <button type="submit" class="btn btn-paw rounded-pill px-4">Tìm kiếm</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #f8f9fa;">
                        <tr>
                            <th class="ps-4 py-3 text-uppercase text-muted small fw-bold">Khách Hàng</th>
                            <th class="text-uppercase text-muted small fw-bold">Liên Hệ</th>
                            <th class="text-uppercase text-muted small fw-bold">Ngày Tham Gia</th>
                            <th class="text-center pe-4 text-uppercase text-muted small fw-bold">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-5"><i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>Chưa có dữ liệu khách hàng.</td></tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle text-white d-flex justify-content-center align-items-center me-3 shadow-sm" style="width: 45px; height: 45px; background-color: #10b981; font-weight: 600;">
                                            @(item.CustomerName.Length > 0 ? item.CustomerName.Substring(0, 1).ToUpper() : "?")
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold text-dark">@item.CustomerName</h6>
                                            <small class="text-muted">ID: @item.Id.ToString().Substring(0, 8)</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="small"><i class="bi bi-telephone text-paw me-2"></i>@item.PhoneNumber</div>
                                    <div class="small text-muted">
                                        <i class="bi bi-envelope me-2"></i>
                                        @if (string.IsNullOrEmpty(item.Email))
                                        {
                                            <span class="fst-italic">Chưa cập nhật</span>
                                        }
                                        else
                                        {
                                            @item.Email
                                        }
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark border px-3 py-2"><i class="bi bi-calendar3 me-1"></i> @item.CreatedAt.ToString("dd/MM/yyyy")</span></td>
                                <td class="text-center pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-circle me-1" title="Sửa" style="width: 35px; height: 35px;"><i class="bi bi-pencil-square text-primary"></i></a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn ngừng hoạt động khách hàng này?');">
                                        <button type="submit" class="btn btn-sm btn-light border rounded-circle" title="Xóa" style="width: 35px; height: 35px;"><i class="bi bi-trash text-danger"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>